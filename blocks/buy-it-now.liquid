{% liquid
  assign block_settings = block.settings
  assign buy_it_now_text = block_settings.buy_it_now_text | default: 'Buy it now'
%}

<button
  type="button"
  class="button {{ block_settings.style_class }} buy-it-now-button"
  name="buy-it-now"
  {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}
>
  {{ buy_it_now_text }}
</button>

{% schema %}
{
  "name": "Buy it now",
  "class": "shopify--buy-it-now",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "buy_it_now_text",
      "label": "按钮文字",
      "default": "Buy it now"
    },
    {
      "type": "text",
      "id": "style_class",
      "label": "CSS 类名",
      "default": "button-primary"
    }
  ]
}
{% endschema %}