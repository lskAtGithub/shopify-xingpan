{% comment %}
  Custom Bottom Section (bottom-section)
  - Renders a 4-column feature grid and a newsletter form.
  - Fully responsive for Desktop, Tablet, and Mobile.
{% endcomment %}

<section class="bottom-section section-{{ section.id }}">
  <div class="bottom-section__container">
    
    <!-- Newsletter Section -->
    <div class="bottom-section__newsletter">
      <h2 class="heading">Join the 11Astrelle Cosmic Community</h2>
      <p class="subtext">
        Connect with fellow cosmic enthusiasts, receive exclusive astrological insights, 
        and be the first to know about new crystal art collections and special offers.
      </p>
      
      {%- form 'customer', class: 'newsletter-form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="newsletter-form__fields">
          <input 
            class="newsletter-form__input"
            type="email" 
            name="contact[email]"
            placeholder="Enter your email address" 
            required
          >
          <button type="submit" class="newsletter-form__button">Join Our Newsletter</button>
        </div>
      {%- endform -%}
    </div>

  </div>
</section>

{% stylesheet %}
.bottom-section {
  padding: 48px 16px;
  background-color: #f9fafb; /* A light gray background */
}

.bottom-section__container {
  max-width: 1280px;
  margin: 0 auto;
}

/* --- Feature Grid Styles --- */
.bottom-section__feature-grid {
  display: grid;
  gap: 30px;
  margin-bottom: 60px;
  /* Mobile: 2 columns */
  grid-template-columns: repeat(2, 1fr);
}

.feature-item {
  text-align: center;
}

.feature-item__icon {
  margin-bottom: 16px;
  height: 60px; /* Fixed height for alignment */
  display: flex;
  justify-content: center;
  align-items: center;
}

.feature-item__icon img {
  max-height: 100%;
  width: auto;
}

.feature-item__title {
  font-size: 1.125rem; /* 18px */
  font-weight: 600;
  margin: 0 0 8px 0;
}

.feature-item__text {
  font-size: 0.95rem;
  color: #555;
  margin: 0;
}

/* --- Newsletter Section Styles --- */
.bottom-section__newsletter {
  text-align: center;
  max-width: 700px;
  margin: 0 auto;
}

.heading {
  font-size: 1.875rem; /* 30px */
  font-weight: 700;
  margin: 0 0 16px 0;
}

.subtext {
  font-size: 1rem;
  color: #555;
  line-height: 1.6;
  margin: 0 0 32px 0;
}

.newsletter-form__fields {
  display: flex;
  gap: 12px;
  /* Mobile: stack vertically */
  flex-direction: column;
}

.newsletter-form__input,
.newsletter-form__button {
  width: 100%;
  padding: 14px 20px;
  font-size: 1rem;
  border-radius: 8px;
  min-height: 50px;
}

.newsletter-form__input {
  border: 1px solid #ccc;
}

.newsletter-form__button {
  background-color: #111827; /* Dark background */
  color: white;
  border: none;
  cursor: pointer;
  transition: opacity 0.3s ease;
}

.newsletter-form__button:hover {
  opacity: 0.85;
}

{% endstylesheet %}

