{% comment %}
  Custom Bottom Section (bottom-section)
  - Renders a 4-column feature grid and a newsletter form.
  - Fully responsive for Desktop, Tablet, and Mobile.
{% endcomment %}

<section class="bottom-section section-{{ section.id }}">
  <div class="bottom-section__container">
    
    <!-- Feature Grid -->
    <div class="bottom-section__feature-grid">
      {%- for i in (1..4) -%}
        {%- liquid
          assign icon_setting = 'feature' | append: i | append: '_icon'
          assign title_setting = 'feature' | append: i | append: '_title'
          assign text_setting = 'feature' | append: i | append: '_text'

          assign icon = section.settings[icon_setting]
          assign title = section.settings[title_setting]
          assign text = section.settings[text_setting]
        -%}
        
        <div class="feature-item">
          {% if icon != blank %}
            <div class="feature-item__icon">
              {{ icon | image_url: width: 120 | image_tag: loading: 'lazy', widths: '60, 120' }}
            </div>
          {% endif %}
          {% if title != blank %}
            <h3 class="feature-item__title">{{ title }}</h3>
          {% endif %}
          {% if text != blank %}
            <p class="feature-item__text">{{ text }}</p>
          {% endif %}
        </div>
      {%- endfor -%}
    </div>

    <!-- Newsletter Section -->
    <div class="bottom-section__newsletter">
      <h2 class="heading">Join the 11STARS Cosmic Community</h2>
      <p class="subtext">
        Connect with fellow cosmic enthusiasts, receive exclusive astrological insights, 
        and be the first to know about new crystal art collections and special offers.
      </p>
      
      {%- form 'customer', class: 'newsletter-form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="newsletter-form__fields">
          <input 
            class="newsletter-form__input"
            type="email" 
            name="contact[email]"
            placeholder="Enter your email address" 
            required
          >
          <button type="submit" class="newsletter-form__button">Join Our Newsletter</button>
        </div>
      {%- endform -%}
    </div>

  </div>
</section>

{% stylesheet %}
.bottom-section {
  padding: 48px 16px;
  background-color: #f9fafb; /* A light gray background */
}

.bottom-section__container {
  max-width: 1280px;
  margin: 0 auto;
}

/* --- Feature Grid Styles --- */
.bottom-section__feature-grid {
  display: grid;
  gap: 30px;
  margin-bottom: 60px;
  /* Mobile: 2 columns */
  grid-template-columns: repeat(2, 1fr);
}

.feature-item {
  text-align: center;
}

.feature-item__icon {
  margin-bottom: 16px;
  height: 60px; /* Fixed height for alignment */
  display: flex;
  justify-content: center;
  align-items: center;
}

.feature-item__icon img {
  max-height: 100%;
  width: auto;
}

.feature-item__title {
  font-size: 1.125rem; /* 18px */
  font-weight: 600;
  margin: 0 0 8px 0;
}

.feature-item__text {
  font-size: 0.95rem;
  color: #555;
  margin: 0;
}

/* --- Newsletter Section Styles --- */
.bottom-section__newsletter {
  text-align: center;
  max-width: 700px;
  margin: 0 auto;
}

.heading {
  font-size: 1.875rem; /* 30px */
  font-weight: 700;
  margin: 0 0 16px 0;
}

.subtext {
  font-size: 1rem;
  color: #555;
  line-height: 1.6;
  margin: 0 0 32px 0;
}

.newsletter-form__fields {
  display: flex;
  gap: 12px;
  /* Mobile: stack vertically */
  flex-direction: column;
}

.newsletter-form__input,
.newsletter-form__button {
  width: 100%;
  padding: 14px 20px;
  font-size: 1rem;
  border-radius: 8px;
  min-height: 50px;
}

.newsletter-form__input {
  border: 1px solid #ccc;
}

.newsletter-form__button {
  background-color: #111827; /* Dark background */
  color: white;
  border: none;
  cursor: pointer;
  transition: opacity 0.3s ease;
}

.newsletter-form__button:hover {
  opacity: 0.85;
}

@media (max-width: 768px) {
  .bottom-section .newsletter-form {
    max-width: 480px;
    margin: 0 20px;
    display: block;
  }
}

/* --- Tablet Styles (768px - 1024px) --- */
@media (min-width: 768px) {
  .bottom-section {
    padding: 64px 24px;
  }
  .heading {
    font-size: 2.25rem; /* 36px */
  }
  .bottom-section__feature-grid {
    gap: 40px;
  }
  .newsletter-form__fields {
    /* Tablet: horizontal layout */
    flex-direction: row;
  }
  .newsletter-form__input {
    flex-grow: 1; /* Input takes available space */
  }
  .newsletter-form__button {
    flex-shrink: 0; /* Button keeps its size */
  }
}

/* --- Desktop Styles (> 1024px) --- */
@media (min-width: 1024px) {
  .bottom-section {
    padding: 80px 32px;
  }
  .bottom-section__feature-grid {
    /* Desktop: 4 columns */
    grid-template-columns: repeat(4, 1fr);
  }
}
{% endstylesheet %}

