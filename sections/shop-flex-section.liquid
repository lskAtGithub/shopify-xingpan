{% schema %}
{
  "name": "Collection with Filters",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "选择商品集合"
    }
  ],
  "blocks": [
    {
      "type": "filter_group",
      "name": "筛选分组",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "分组标题"
        },
        {
          "type": "textarea",
          "id": "options",
          "label": "选项（每行一个）",
          "default": "选项1\n选项2\n选项3"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection with Filters",
      "category": "Collection"
    }
  ]
}
{% endschema %}

<section class="collection-with-filters">
  <div class="cw-container">
    <!-- 左侧筛选 -->
    <aside class="cw-filters">
      {% for block in section.blocks %}
        <div class="cw-accordion">
          <button class="cw-accordion-toggle" type="button">
            <span>{{ block.settings.title }}</span>
            <span class="icon">+</span>
          </button>
          <div class="cw-accordion-content">
            {% assign opts = block.settings.options | newline_to_br | split: '<br />' %}
            {% for opt in opts %}
              <label class="cw-filter-option">
                <input type="checkbox" class="filter-checkbox" value="{{ opt | strip }}">
                <span>{{ opt }}</span>
              </label>
            {% endfor %}
          </div>
        </div>
      {% endfor %}
    </aside>

    <!-- 右侧商品 -->
    <div class="cw-products">
      {% if section.settings.collection %}
        {% assign products = collections[section.settings.collection].products %}
        <div class="cw-grid">
          {% for product in products %}
            <div class="cw-product-card" data-tags="{{ product.tags | join: ',' }}">
              <a href="{{ product.url }}">
                {{ product.featured_image | image_url: width: 400 | image_tag: class: 'cw-img' }}
                <h3 class="cw-title">{{ product.title }}</h3>
                <p class="cw-price">{{ product.price | money }}</p>
              </a>
            </div>
          {% endfor %}
        </div>
      {% else %}
        <p>请在编辑器中选择一个集合</p>
      {% endif %}
    </div>
  </div>
</section>

<style>
  /* 外层容器 */
  .collection-with-filters .cw-container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    gap: 20px;
  }

  /* 左侧筛选 */
  .cw-filters {
    width: 260px;
    flex-shrink: 0;
  }
  .cw-accordion {
    border-bottom: 1px solid #ddd;
  }
  .cw-accordion-toggle {
    width: 100%;
    padding: 12px;
    background: #f7f7f7;
    border: none;
    text-align: left;
    font-weight: bold;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .cw-accordion-content {
    display: none;
    padding: 10px 12px;
  }
  .cw-accordion.open .cw-accordion-content {
    display: block;
  }
  .cw-filter-option {
    display: flex;
    align-items: center;
    margin-bottom: 6px;
    font-size: 14px;
  }
  .cw-filter-option input {
    margin-right: 8px;
  }

  /* 右侧商品 */
  .cw-products {
    flex: 1;
  }
  .cw-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }
  .cw-product-card {
    border: 1px solid #eee;
    padding: 12px;
    text-align: center;
    transition: box-shadow 0.2s ease;
  }
  .cw-product-card:hover {
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  }
  .cw-img {
    max-width: 100%;
    height: auto;
    margin-bottom: 8px;
  }
  .cw-title {
    font-size: 14px;
    margin: 6px 0;
  }
  .cw-price {
    font-size: 14px;
    color: #d33;
    font-weight: bold;
  }
</style>

<script>
  function initAccordionFilter(container) {
    // 手风琴展开收起
    container.querySelectorAll('.cw-accordion-toggle').forEach((btn) => {
      btn.addEventListener('click', () => {
        e.preventDefault(); // 阻止默认行为
        e.stopPropagation(); // 阻止冒泡，避免被别的脚本接管
        console.log('点击了:', btn, '原class:', btn.parentElement.className);
        btn.parentElement.classList.toggle('open');
        console.log('切换后class:', btn.parentElement.className);
      });
    });

    // 过滤逻辑（基于 tags）
    const checkboxes = container.querySelectorAll('.filter-checkbox');
    const products = container.querySelectorAll('.cw-product-card');

    checkboxes.forEach((cb) => {
      cb.addEventListener('change', () => {
        let activeFilters = Array.from(checkboxes)
          .filter((c) => c.checked)
          .map((c) => c.value.toLowerCase());

        products.forEach((p) => {
          const tags = p.dataset.tags.toLowerCase();
          if (activeFilters.length === 0 || activeFilters.some((f) => tags.includes(f))) {
            p.style.display = '';
          } else {
            p.style.display = 'none';
          }
        });
      });
    });
  }

  // 初次加载执行
  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('.collection-with-filters').forEach((section) => {
      initAccordionFilter(section);
    });
  });

  // Shopify 编辑器里动态加载 section 时执行
  document.addEventListener('shopify:section:load', function (e) {
    const section = e.target.querySelector('.collection-with-filters');
    if (section) initAccordionFilter(section);
  });
</script>
