{% schema %}
{
  "name": "Collection with Filters",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "选择商品集合"
    }
  ],
  "blocks": [
    {
      "type": "filter_group",
      "name": "筛选分组",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "分组标题"
        },
        {
          "type": "textarea",
          "id": "options",
          "label": "选项（每行一个）",
          "default": "选项1\n选项2\n选项3"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection with Filters",
      "category": "Collection"
    }
  ]
}
{% endschema %}

<section class="collection-with-filters">
  <div class="cw-container">
    <!-- 左侧筛选 -->
    <aside class="cw-filters">
      {% for block in section.blocks %}
        <div class="cw-accordion">
          <button class="cw-accordion-toggle" type="button">
            <span>{{ block.settings.title }}</span>
            <span class="icon">+</span>
          </button>
          <div class="cw-accordion-content">
            {% assign opts = block.settings.options | newline_to_br | split: '<br />' %}
            {% for opt in opts %}
              <label class="cw-filter-option">
                <input type="checkbox" class="filter-checkbox" value="{{ opt | strip }}">
                <span>{{ opt }}</span>
              </label>
            {% endfor %}
          </div>
        </div>
      {% endfor %}
    </aside>

    <!-- 右侧商品 -->
    <div class="cw-products">
      {% if section.settings.collection %}
        {% assign products = collections[section.settings.collection].products %}
        <div class="cw-grid">
          {% for product in products %}
            <div class="cw-product-card" data-tags="{{ product.tags | join: ',' }}">
              <a href="{{ product.url }}">
                {{ product.featured_image | image_url: width: 400 | image_tag: class: 'cw-img' }}
                <h3 class="cw-title">{{ product.title }}</h3>
                <p class="cw-price">{{ product.price | money }}</p>
              </a>
            </div>
          {% endfor %}
        </div>
      {% else %}
        <p>请在编辑器中选择一个集合</p>
      {% endif %}
    </div>
  </div>
</section>

<style>
  /* 外层容器 */
  .collection-with-filters .cw-container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    gap: 20px;
  }

  /* 左侧筛选 */
  .cw-filters {
    width: 260px;
    flex-shrink: 0;
  }
  .cw-accordion {
    border-bottom: 1px solid #ddd;
  }
  .cw-accordion-toggle {
    width: 100%;
    padding: 12px;
    background: #f7f7f7;
    border: none;
    text-align: left;
    font-weight: bold;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .cw-accordion-content {
    display: none;
    padding: 10px 12px;
  }
  .cw-accordion.open .cw-accordion-content {
    display: block;
  }
  .cw-filter-option {
    display: flex;
    align-items: center;
    margin-bottom: 6px;
    font-size: 14px;
  }
  .cw-filter-option input {
    margin-right: 8px;
  }

  /* 右侧商品 */
  .cw-products {
    flex: 1;
  }
  .cw-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }
  .cw-product-card {
    border: 1px solid #eee;
    padding: 12px;
    text-align: center;
    transition: box-shadow 0.2s ease;
  }
  .cw-product-card:hover {
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  }
  .cw-img {
    max-width: 100%;
    height: auto;
    margin-bottom: 8px;
  }
  .cw-title {
    font-size: 14px;
    margin: 6px 0;
  }
  .cw-price {
    font-size: 14px;
    color: #d33;
    font-weight: bold;
  }
</style>

<script>
(function () {
  // 初始化单个 section（用 dataset 标记防止重复）
  function initAccordionFilter(container) {
    if (!container || container.dataset.accordionInit === 'true') return;
    container.dataset.accordionInit = 'true';

    // 事件委托：只在 container 上挂一个 click 处理手风琴
    container.addEventListener('click', function (e) {
      const btn = e.target.closest('.cw-accordion-toggle');
      if (!btn || !container.contains(btn)) return;

      e.preventDefault();
      const parent = btn.parentElement;
      parent.classList.toggle('open');

      // 如果要切换 + / - 图标
      const icon = btn.querySelector('.icon');
      if (icon) icon.textContent = parent.classList.contains('open') ? '−' : '+';
    });

    // 事件委托：只在 container 上挂一个 change 处理复选过滤
    container.addEventListener('change', function (e) {
      if (!e.target.matches('.filter-checkbox')) return;

      const checkboxes = container.querySelectorAll('.filter-checkbox');
      const activeFilters = Array.from(checkboxes)
        .filter(c => c.checked)
        .map(c => c.value.toLowerCase());

      const products = container.querySelectorAll('.cw-product-card');
      products.forEach(p => {
        const tags = (p.dataset.tags || '').toLowerCase();
        p.style.display = (activeFilters.length === 0 || activeFilters.some(f => tags.includes(f))) ? '' : 'none';
      });
    });
  }

  // 初始化页面内所有该 section
  function initAll() {
    document.querySelectorAll('.collection-with-filters').forEach(initAccordionFilter);
  }

  // 监听常见入口（有 guard 防重）
  document.addEventListener('DOMContentLoaded', initAll);

  document.addEventListener('shopify:section:load', function (e) {
    // e.target 可能是 section 根节点，也可能包含多个 section
    if (e.target && e.target.matches && e.target.matches('.collection-with-filters')) {
      initAccordionFilter(e.target);
    } else if (e.target && e.target.querySelectorAll) {
      e.target.querySelectorAll('.collection-with-filters').forEach(initAccordionFilter);
    } else {
      initAll();
    }
  });

  // 当 section 被卸载时，清除初始化标记（编辑器里会重新加载时需要重新 init）
  document.addEventListener('shopify:section:unload', function (e) {
    const section = (e.target && e.target.matches && e.target.matches('.collection-with-filters')) ? e.target :
                    (e.target && e.target.querySelector && e.target.querySelector('.collection-with-filters'));
    if (section && section.dataset) {
      delete section.dataset.accordionInit;
    }
  });

  // 可选：便于调试（打开控制台看初始化次数）
  console.log('Accordion filter script loaded');
})();
</script>

