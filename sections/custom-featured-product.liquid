<style>
  .section-{{ section.id }} {
    --background-color: {{ section.settings.background_color }};
    --text-color: {{ section.settings.text_color }};
    background-color: var(--background-color);
    color: var(--text-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  .section-{{ section.id }}.page-width {
    max-width: 1280px;
    margin: 0 auto;
  }
</style>

<div class="page-width section-{{ section.id }}">
  <div class="custom-featured-product__header">
    {% if section.settings.heading != blank %}
      <h2>{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.subheading != blank %}
      <div class="rte">{{ section.settings.subheading }}</div>
    {% endif %}
  </div>

  <div class="custom-featured-product__list">
    {% for block in section.blocks %}
      {%- assign product = block.settings.featured_product -%}
      {% if product != blank %}
        <div
          class="custom-featured-product__item {% cycle 'layout--normal', 'layout--reversed' %}"
          {{ block.shopify_attributes }}
        >
          <a class="custom-featured-product__image-wrapper" href="/products/{{ product.handle }}">
            {% if block.settings.badge_text != blank %}
              <div class="custom-featured-product__badge">{{ block.settings.badge_text }}</div>
            {% endif %}

            {% if product.featured_media %}
              {{
                product.featured_media
                | image_url: width: 1000
                | image_tag:
                  loading: 'lazy',
                  widths: '300, 400, 600, 800, 1000',
                  sizes: '(max-width: 768px) 100vw, 50vw'
              }}
            {% else %}
              {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {% endif %}
          </a>

          <div class="custom-featured-product__info">
            {%- assign title = block.settings.product_title_override | default: product.title -%}
            <h3>{{ title }}</h3>

            {%- assign description = block.settings.product_description_override | default: product.description -%}
            <div class="rte">{{ description }}</div>

            {%- assign features = block.settings.features_list | split: '$$' -%}
            {% if features.size > 0 %}
              <ul class="custom-featured-product__features-list">
                {% for feature in features %}
                  {% if feature != blank %}
                    <li>
                      <svg
                        class="icon-checkmark"
                        xmlns="http://www.w3.org/2000/svg"
                        width="15"
                        height="15"
                        viewBox="0 0 15 15"
                        fill="none"
                      >
                        <g clip-path="url(#clip0_1572_18)">
                        <circle cx="7.5" cy="7.92969" r="7" fill="black"/>
                        <path d="M4 7.34644L5.51906 9.24526C5.95344 9.78823 6.76335 9.83309 7.25503 9.34141L11 5.59644" stroke="white" stroke-width="1.16667" stroke-linecap="round"/>
                        </g>
                        <defs>
                        <clipPath id="clip0_1572_18">
                        <rect width="14" height="14" fill="white" transform="translate(0.5 0.929688)"/>
                        </clipPath>
                        </defs>
                      </svg>
                      <span style="line-height: 1.2;">{{ feature }}</span>
                    </li>
                  {% endif %}
                {% endfor %}
              </ul>
            {% endif %}

            <div class="custom-featured-product__price-and-cta">
              <span class="price">{{ product.price | money }}</span>
              <div class="buttons-wrapper">
                {%- assign current_variant = product.selected_or_first_available_variant -%}
                <form
                  method="post"
                  action="/cart/add"
                  accept-charset="UTF-8"
                  enctype="multipart/form-data"
                  novalidate="novalidate"
                >
                  <input type="hidden" name="id" value="{{ current_variant.id }}">
                  <button type="submit" class="button button--primary">Add to Cart</button>
                </form>
                <a href="{{ product.url }}" class="button button--secondary">
                  <svg class="icon-eye" xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 17 17" fill="none">
                    <g clip-path="url(#clip0_756_422)">
                    <path d="M15.5162 8.1356C14.6096 6.72893 13.4762 5.67893 12.1163 4.9856C12.4762 5.59893 12.6562 6.2656 12.6562 6.9856C12.6562 8.09226 12.2662 9.0356 11.4862 9.8156C10.6996 10.5956 9.75625 10.9856 8.65625 10.9856C7.55625 10.9856 6.61292 10.5956 5.82625 9.8156C5.04625 9.0356 4.65625 8.09226 4.65625 6.9856C4.65625 6.2656 4.83625 5.59893 5.19625 4.9856C3.83625 5.67893 2.70292 6.72893 1.79625 8.1356C2.58958 9.3556 3.58292 10.3256 4.77625 11.0456C5.96958 11.7723 7.26292 12.1356 8.65625 12.1356C10.0496 12.1356 11.3429 11.7723 12.5363 11.0456C13.7296 10.3256 14.7229 9.3556 15.5162 8.1356ZM8.95625 5.0056C9.04292 4.9256 9.08625 4.8256 9.08625 4.7056C9.08625 4.5856 9.04292 4.48226 8.95625 4.3956C8.87625 4.3156 8.77625 4.2756 8.65625 4.2756C7.90958 4.2756 7.26958 4.54226 6.73625 5.0756C6.20958 5.60893 5.94625 6.2456 5.94625 6.9856C5.94625 7.1056 5.98625 7.20893 6.06625 7.2956C6.15292 7.3756 6.25292 7.4156 6.36625 7.4156C6.48625 7.4156 6.58958 7.3756 6.67625 7.2956C6.75625 7.20893 6.79625 7.1056 6.79625 6.9856C6.79625 6.47893 6.97958 6.04226 7.34625 5.6756C7.70625 5.3156 8.14292 5.1356 8.65625 5.1356C8.77625 5.1356 8.87625 5.09226 8.95625 5.0056ZM16.4762 7.5156C16.5962 7.72226 16.6562 7.92893 16.6562 8.1356C16.6562 8.3356 16.5962 8.53893 16.4762 8.7456C15.6429 10.1189 14.5229 11.2156 13.1163 12.0356C11.7096 12.8623 10.2229 13.2756 8.65625 13.2756C7.08958 13.2756 5.60292 12.8623 4.19625 12.0356C2.78958 11.2089 1.66958 10.1123 0.83625 8.7456C0.71625 8.53893 0.65625 8.3356 0.65625 8.1356C0.65625 7.92893 0.71625 7.72226 0.83625 7.5156C1.66958 6.1556 2.78958 5.06226 4.19625 4.2356C5.60292 3.40226 7.08958 2.9856 8.65625 2.9856C10.2229 2.9856 11.7096 3.40226 13.1163 4.2356C14.5229 5.06226 15.6429 6.1556 16.4762 7.5156Z" fill="black"></path>
                    </g>
                    <defs>
                    <clipPath id="clip0_756_422">
                    <rect width="16" height="10.2857" fill="white" transform="translate(0.65625 2.98999)"></rect>
                    </clipPath>
                    </defs>
                  </svg>
                </a>
              </div>
            </div>
          </div>
        </div>
      {% endif %}
    {% endfor %}

    {% if section.blocks.size == 0 %}
      <p>请在后台添加产品特色块。</p>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .custom-featured-product__header {
    text-align: center;
    margin-bottom: 50px;
  }
  .custom-featured-product__header h2 {
    font-size: 2.5rem;
    margin-bottom: 15px;
  }
  .custom-featured-product__header .rte {
    font-size: 1rem;
    max-width: 600px;
    margin: 0 auto;
  }

  .custom-featured-product__list {
    display: flex;
    flex-direction: column;
    gap: 80px; /* Space between product rows */
    padding: 0 1rem;
  }

  .custom-featured-product__item {
    display: grid;
    grid-template-columns: 1fr; /* Mobile first: single column */
    gap: 40px;
    align-items: center;
  }

  /* Desktop layout */
  @media (min-width: 769px) {
    .custom-featured-product__item:nth-child(odd) {
      grid-template-columns: 1.4fr 1fr; /* Two columns on desktop */
      gap: 60px;
    }
    .custom-featured-product__item:nth-child(even) {
      grid-template-columns: 1fr 1.4fr; /* Two columns on desktop */
      gap: 60px;
    }
    .custom-featured-product__item.layout--reversed .custom-featured-product__image-wrapper {
      order: 2; /* Move image to the right */
    }
    .custom-featured-product__item.layout--reversed .custom-featured-product__info {
      order: 1; /* Move info to the left */
    }
  }

  .custom-featured-product__image-wrapper {
    position: relative;
    border-radius: 10px;
    overflow: hidden;
  }
  .custom-featured-product__image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .custom-featured-product__badge {
    position: absolute;
    top: 20px;
    left: 20px;
    background-color: #fbbf24;
    color: #1f2937;
    padding: 8px 16px;
    border-radius: 9999px;
    font-weight: 600;
    z-index: 2;
  }
  /* Adjust badge for reversed layout */
  .layout--reversed .custom-featured-product__badge {
    left: auto;
    right: 20px;
  }

  .custom-featured-product__info h3 {
    font-size: 2.2rem;
    margin-bottom: 15px;
  }
  .custom-featured-product__info .rte {
    font-size: 1rem;
    line-height: 1.6;
    margin-bottom: 25px;
  }
  .custom-featured-product__features-list {
    list-style: none;
    padding: 0;
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
    align-items: center;
    margin: 0 0 30px 0;
  }
  .custom-featured-product__features-list li {
    display: flex;
    align-items: center;
    margin-bottom: 10px;
  }
  .custom-featured-product__features-list .icon-checkmark {
    margin-right: 5px;
  }
  .custom-featured-product__price-and-cta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 20px;
  }
  .custom-featured-product__price-and-cta .price {
    font-size: 2rem;
    font-weight: 700;
  }
  .custom-featured-product__price-and-cta .buttons-wrapper {
    display: flex;
    gap: 10px;
  }

  /* Base button styles - adjust to your theme */
  .button {
    padding: 12px 24px;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
    border: 1px solid transparent;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .button--primary {
    background-color: #111;
    color: #fff;
    min-height: 40px;
  }
  .button--primary:hover {
    opacity: 0.85;
  }
  .button--secondary {
    background-color: transparent;
    border: 1px solid #111!important;
    padding: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .button--secondary .icon-eye {
    width: 24px;
    height: 24px;
  }
  .button--secondary:hover {
    border-color: #d1d5db;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "特色产品集合",
  "tag": "section",
  "class": "section-custom-featured-product",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "全局标题",
      "default": "Elemental Crystal Art"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "全局描述",
      "default": "<p>Each piece is infused with energy to balance your elemental composition, handcrafted with natural crystals and premium materials.</p>"
    },
    {
      "type": "header",
      "content": "样式设置"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "背景颜色",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "文本颜色",
      "default": "#333333"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "顶部内边距",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "底部内边距",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "featured_product",
      "name": "特色产品",
      "limit": 6,
      "settings": [
        {
          "type": "product",
          "id": "featured_product",
          "label": "选择产品"
        },
        {
          "type": "text",
          "id": "badge_text",
          "label": "图片徽章文本",
          "default": "New Element"
        },
        {
          "type": "text",
          "id": "product_title_override",
          "label": "产品标题 (覆盖)",
          "info": "留空则使用产品的默认标题"
        },
        {
          "type": "richtext",
          "id": "product_description_override",
          "label": "产品描述 (覆盖)",
          "info": "留空则使用产品的默认描述"
        },
        {
          "type": "textarea",
          "id": "features_list",
          "label": "特性列表",
          "info": "每行一个特性，用$$分隔"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "特色产品集合",
      "blocks": [{ "type": "featured_product" }, { "type": "featured_product" }]
    }
  ]
}
{% endschema %}
