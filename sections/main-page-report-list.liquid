{% comment %}
  Report List Page Section
  - Checks for customer login status.
  - Fetches and displays report list from an external API if logged in.
  - Shows a login prompt if not logged in.
  - Fully responsive grid layout.
{% endcomment %}

<div class="report-list-page section-{{ section.id }}">
  <div class="page-width">

    {% if customer %}
      <!-- ============================================= -->
      <!-- ========= START: LOGGED IN VIEW ========= -->
      <!-- ============================================= -->
      <div id="report-list-container" data-customer-id="{{ customer.id }}" data-customer-name="{{ customer.first_name }} {{ customer.last_name }}">
        <div class="report-list-header">
          <h1>My Reports</h1>
          <p id="report-count"></p>
        </div>

        <!-- Loading Spinner -->
        <div id="loading-spinner" class="spinner-container">
          <div class="spinner"></div>
          <p>Loading your reports...</p>
        </div>
        
        <!-- Reports Grid -->
        <div id="reports-grid" class="reports-grid">
          <!-- Report cards will be injected here by JavaScript -->
        </div>

        <!-- Empty Report List -->
        <div id="empty-report-message" style="display: none;">
        </div>
        
        <!-- Error Message -->
        <div id="error-message" class="message-container" style="display: none;"></div>
      </div>
      <!-- ============================================= -->
      <!-- ========= END: LOGGED IN VIEW ========= -->
      <!-- ============================================= -->

    {% else %}
      <!-- ============================================= -->
      <!-- ======= START: LOGGED OUT VIEW ======= -->
      <!-- ============================================= -->
      <div class="logged-out-container message-container">
        <p>You can view your report only after logging in to your account</p>
        <a href="/account/login" class="button">Log in now</a>
      </div>
      <!-- ============================================= -->
      <!-- ========= END: LOGGED OUT VIEW ======== -->
      <!-- ============================================= -->
    {% endif %}

  </div>
</div>

{% stylesheet %}
.report-list-page {
  padding: 3rem 1rem;
}
.page-width {
  max-width: 1200px;
  margin: 0 auto;
}

/* --- Message & Loading Styles --- */
.message-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 4rem 1rem;
  background-color: #f9fafb;
  border-radius: 12px;
  min-height: 40vh;
}
.message-container p {
  font-size: 1.125rem;
  color: #555;
  margin: 0 0 1.5rem 0;
}
.message-container .button {
  display: inline-block;
  background-color: #2D3748;
  color: #fff;
  padding: 0.75rem 2rem;
  border-radius: 8px;
  text-decoration: none;
  font-weight: 500;
  transition: background-color 0.2s ease;
}
.message-container .button:hover {
  background-color: #1a202c;
}

.spinner-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 40vh;
  gap: 1.5rem;
}
.spinner {
  width: 48px; height: 48px;
  border: 5px solid #f3f3f3;
  border-top: 5px solid #3498db;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}
@keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }

/* --- Logged In View Styles --- */
.report-list-header {
  text-align: center;
  margin-bottom: 3rem;
}
.report-list-header h1 {
  font-size: 2.5rem;
  margin: 0 0 0.5rem 0;
}
.report-list-header p {
  font-size: 1rem;
  color: #777;
}

.reports-grid {
  display: grid;
  gap: 1.5rem;
  grid-template-columns: 1fr; /* Mobile: 1 column */
}

.report-card {
  background-color: #fff;
  border: 1px solid #e5e7eb;
  border-radius: 12px;
  padding: 1.5rem;
  box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);
  display: flex;
  flex-direction: column;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  border-bottom: 1px solid #f3f4f6;
  padding-bottom: 1rem;
  margin-bottom: 1rem;
}
.card-title {
  display: flex;
  align-items: center;
  gap: 12px;
  font-size: 1.25rem;
  font-weight: 600;
}
.card-delete-btn { background: none; border: none; cursor: pointer; color: #999; }
.card-delete-btn:hover { color: #e53e3e; }

.card-body {
  flex-grow: 1;
}
.card-detail {
  font-size: 0.9rem;
  color: #555;
  margin-bottom: 0.5rem;
}

.recommended-product {
  display: flex;
  gap: 12px;
  background-color: #f9fafb;
  padding: 12px;
  border-radius: 8px;
  margin: 1rem 0;
}
.product-image { width: 60px; height: 60px; object-fit: cover; border-radius: 4px; }
.product-info h4 { font-size: 1rem; margin: 0 0 4px 0; }
.product-info p { font-size: 0.9rem; margin: 0; }
.product-info p.product-price {  }
.product-info p.product-decoration, .product-info p span { 
  color: #999;
 }

.card-footer {
  margin-top: 1.5rem;
  display: flex;
  gap: 12px;
}
.card-footer .button {
  flex: 1; text-align: center;
  padding: 0.625rem 1rem;
  border-radius: 8px; text-decoration: none;
  font-weight: 500; transition: all 0.2s ease;
}
.button--secondary { background: #fff; border: 1px solid #d1d5db; color: #333; }
.button--secondary:hover { background-color: #f9fafb; }
.button--primary { background: #2D3748; border: 1px solid #2D3748; color: #fff; }
.button--primary:hover { background-color: #1a202c; }

/* --- Responsive Grid --- */
@media (min-width: 768px) {
  .reports-grid {
    grid-template-columns: repeat(2, 1fr); /* Tablet: 2 columns */
  }
}
@media (min-width: 1024px) {
  .reports-grid {
    grid-template-columns: repeat(3, 1fr); /* Desktop: 3 columns */
  }
}
{% endstylesheet %}

<script>
document.addEventListener('DOMContentLoaded', () => {
  const container = document.getElementById('report-list-container');
  if (!container) return; // Exit if not logged in

  const customerId = container.dataset.customerId;
  const customerName = container.dataset.customerName;
  const grid = document.getElementById('reports-grid');
  const spinner = document.getElementById('loading-spinner');
  const errorMsg = document.getElementById('error-message');
  const reportCountEl = document.getElementById('report-count');
  const emptyReportMsg = document.getElementById('empty-report-message');

  const BASE_URL = 'https://api.11astrelle.com';

  async function fetchReports() {
    try {
      const response = await fetch(`${BASE_URL}/report/getList?key=${customerId}`);
      
      if (!response.ok) {
        throw new Error(`API Error: ${response.status} ${response.statusText}`);
      }

      const result = await response.json();
      
      spinner.style.display = 'none';

      if (result.code === 0 && result.data && result.data.length > 0) {
        reportCountEl.textContent = `You have ${result.data.length} reports.`;
        emptyReportMsg.style.display = 'none';
        renderReports(result.data);
      } else {
        emptyReportMsg.innerHTML = '<div class="message-container"><p>You don\'t have any reports yet. Go create your first one!</p></div>';
        emptyReportMsg.style.display = 'block';
      }

    } catch (error) {
      console.error('Failed to fetch reports:', error);
      spinner.style.display = 'none';
      errorMsg.textContent = 'Sorry, we couldn\'t load your reports at this time. Please try again later.';
      errorMsg.style.display = 'block';
    }
  }

  function renderReports(reports) {
    grid.innerHTML = ''; // Clear grid
    reports.forEach(report => {
      // Assuming 'scoreProductMap' has one product for simplicity
      const productKey = Object.keys(report.scoreProductMap || {})[0];
      const productData = productKey ? report.scoreProductMap[productKey] : null;

      const card = document.createElement('div');
      card.className = 'report-card';
      card.innerHTML = `
        <div class="card-header">
          <div class="card-title">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
            <span>${report.userName || 'Untitled Report'}</span>
          </div>
          <button class="card-delete-btn" data-report-id="${report.id}" aria-label="Delete report">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
          </button>
        </div>
        <div class="card-body">
          <p class="card-detail"><strong>Birth time:</strong> ${report.birthday || 'N/A'}</p>
          <p class="card-detail"><strong>Birth Place:</strong> ${report.address || 'N/A'}</p>
          
          ${productData ? `
            <div class="recommended-product">
              <img src="${productData.image}" class="product-image" data-product-title="${productData.title}" alt="Recommended product">
              <div class="product-info">
                <h4>${productData.title}</h4>
                <p class="product-decoration">${productData.bodyHtml}</p>
                <p class="product-price">$129</p>
              </div>
            </div>
          ` : ''}
          
          <p class="card-detail"><small>Generated: ${new Date(report.cTime).toLocaleString()}</small></p>
        </div>
        <div class="card-footer">
          <a href="${report.pdfPath || '#'}" class="button button--secondary" download>Download PDF</a>
          <a href="/pages/report?id=${report.uuid}" class="button button--primary">View Report</a>
        </div>
      `;
      grid.appendChild(card);
    });

    // Post-render step: Fetch and populate product images
    {% comment %} document.querySelectorAll('.product-image[data-product-title]').forEach(async (img) => {
      const title = img.dataset.productTitle;
      const handle = title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
      try {
        const productRes = await fetch(`/products/${handle}.js`);
        if (productRes.ok) {
          const product = await productRes.json();
          img.src = product.featured_image || '/assets/placeholder-image.png';
        }
      } catch (e) { console.error('Could not fetch product image for', title); }
    }); {% endcomment %}
  }

  fetchReports();
});
</script>

{% schema %}
  {
    "name": "Report List Page",
    "settings": []
  }
{% endschema %}