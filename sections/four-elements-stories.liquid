{% comment %}
  Four Elements Stories Section (UI Optimized)
  - Uses fixed icons and colors as per design spec.
  - Adds a custom description field for each element, separate from the article excerpt.
{% endcomment %}

<style>
  .section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  .section-{{ section.id }}.page-width {
    max-width: 1280px;
    margin: 0 auto;
  }
</style>

<div class="page-width section-{{ section.id }}">
  <div class="four-elements__grid">
    <div class="four-elements__content">
      <div class="four-elements__header">
        {% if section.settings.heading != blank %}
          <h2>{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.subheading != blank %}
          <div class="rte">{{ section.settings.subheading }}</div>
        {% endif %}
      </div>

      <div class="four-elements__stories-list">
        {% comment %} --- Story Block 1: Fire --- {% endcomment %}
        {%- assign fire_article = articles[section.settings.fire_article] -%}
        {% if fire_article != blank %}
          <a href="blogs/blog-center?tags=fire" class="story-block story-block--fire">
            <div class="story-block__icon">
              {% render 'icon-fire' %}
            </div>
            <div class="story-block__text">
              <h3 class="story-block__title">{{ fire_article.title }}</h3>
              <div class="story-block__excerpt rte">{{ section.settings.fire_description }}</div>
              <span class="story-block__link">Read More &rarr;</span>
            </div>
          </a>
        {% endif %}

        {% comment %} --- Story Block 2: Water --- {% endcomment %}
        {%- assign water_article = articles[section.settings.water_article] -%}
        {% if water_article != blank %}
          <a href="blogs/blog-center?tags=water" class="story-block story-block--water">
            <div class="story-block__icon">
              {% render 'icon-water' %}
            </div>
            <div class="story-block__text">
              <h3 class="story-block__title">{{ water_article.title }}</h3>
              <div class="story-block__excerpt rte">{{ section.settings.water_description }}</div>
              <span class="story-block__link">Read More &rarr;</span>
            </div>
          </a>
        {% endif %}
        
        {% comment %} --- Story Block 3: Earth --- {% endcomment %}
        {%- assign earth_article = articles[section.settings.earth_article] -%}
        {% if earth_article != blank %}
          <a href="blogs/blog-center?tags=earth" class="story-block story-block--earth">
            <div class="story-block__icon">
              {% render 'icon-earth' %}
            </div>
            <div class="story-block__text">
              <h3 class="story-block__title">{{ earth_article.title }}</h3>
              <div class="story-block__excerpt rte">{{ section.settings.earth_description }}</div>
              <span class="story-block__link">Read More &rarr;</span>
            </div>
          </a>
        {% endif %}

        {% comment %} --- Story Block 4: Air --- {% endcomment %}
        {%- assign air_article = articles[section.settings.air_article] -%}
        {% if air_article != blank %}
          <a href="blogs/blog-center?tags=air" class="story-block story-block--air">
            <div class="story-block__icon">
              {% render 'icon-air' %}
            </div>
            <div class="story-block__text">
              <h3 class="story-block__title">{{ air_article.title }}</h3>
              <div class="story-block__excerpt rte">{{ section.settings.air_description }}</div>
              <span class="story-block__link">Read More &rarr;</span>
            </div>
          </a>
        {% endif %}
      </div>
    </div>

    <div class="four-elements__image">
      {% if section.settings.image != blank %}
        {{ section.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '400, 600, 800, 1000', sizes: '(max-width: 768px) 100vw, 50vw' }}
      {% else %}
        {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
      {% endif %}
    </div>
  </div>
</div>

{% stylesheet %}
.four-elements__grid { display: grid; grid-template-columns: 1fr; gap: 40px; }
@media (min-width: 769px) { .four-elements__grid { grid-template-columns: 1fr 1fr; gap: 60px; align-items: flex-start; } }

.section-four-elements { padding: 1rem; }
.four-elements__header { margin-bottom: 40px; }
.four-elements__header h2 { font-size: 2.5rem; margin-bottom: 15px; }
.four-elements__header .rte { font-size: 1rem; color: #555; }

.four-elements__stories-list { display: grid; gap: 20px; }

.story-block {
  display: flex;
  align-items: flex-start;
  gap: 20px;
  padding: 24px;
  border-radius: 12px;
  border: 1px solid; /* Border is now defined by specific classes */
  text-decoration: none;
  color: inherit;
  transition: box-shadow 0.3s ease, transform 0.3s ease;
}
.story-block:hover { transform: translateY(-5px); box-shadow: 0 10px 20px rgba(0,0,0,0.07); }

.story-block__icon {
  flex-shrink: 0;
  width: 48px;
  height: 48px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.story-block__icon svg { width: 100%; height: 100%; color: white; }

.story-block__title { margin: 0 0 8px 0; font-size: 1.1rem; font-weight: 700; }
.story-block__excerpt { margin: 0 0 12px 0; font-size: 0.95rem; color: #555; line-height: 1.6; }
.story-block__excerpt p { margin: 0; }
.story-block__link { font-weight: 600; font-size: 0.9rem; }

.four-elements__image { border-radius: 16px; overflow: hidden; }
.four-elements__image img { width: 100%; height: 100%; object-fit: cover; display: block; }
@media (max-width: 768px) { .four-elements__image { order: -1; } }

/* --- 关键变更: 硬编码的元素样式 --- */
/* Fire */
.story-block--fire { background-color: rgba(251, 191, 36, 0.05); border-color: rgba(251, 191, 36, 0.2); }
/* .story-block--fire .story-block__icon { background-color: #FBBF24; } */
.story-block--fire .story-block__link { color: #D97706; }

/* Water */
.story-block--water { background-color: rgba(74, 144, 226, 0.05); border-color: rgba(74, 144, 226, 0.2); }
/* .story-block--water .story-block__icon { background-color: #4A90E2; } */
.story-block--water .story-block__link { color: #2563EB; }

/* Earth */
.story-block--earth { background-color: rgba(139, 90, 43, 0.05); border-color: rgba(139, 90, 43, 0.2); }
/* .story-block--earth .story-block__icon { background-color: #8B5A2B; } */
.story-block--earth .story-block__link { color: #78350F; }

/* Air */
.story-block--air { background-color: rgba(76, 175, 80, 0.05); border-color: rgba(76, 175, 80, 0.2); }
/* .story-block--air .story-block__icon { background-color: #4CAF50; } */
.story-block--air .story-block__link { color: #166534; }
{% endstylesheet %}

{% schema %}
{
  "name": "四元素故事",
  "tag": "section",
  "class": "section-four-elements",
  "settings": [
    {
      "type": "header", "content": "全局内容"
    },
    {
      "type": "text", "id": "heading", "label": "标题", "default": "Stories of the Four Elements"
    },
    {
      "type": "richtext", "id": "subheading", "label": "副标题", "default": "<p>Ancient wisdom meets modern energy—explore the origins and significance of fire, water, earth, and air in astrology and metaphysics.</p>"
    },
    {
      "type": "image_picker", "id": "image", "label": "特色图片"
    },
    {
      "type": "header", "content": "火元素 (Fire)"
    },
    {
      "type": "article", "id": "fire_article", "label": "选择文章"
    },
    {
      "type": "richtext", "id": "fire_description", "label": "自定义描述", "default": "<p>Discover how fire represents our life force, creativity, and ability to transform energy into action.</p>"
    },
    {
      "type": "header", "content": "水元素 (Water)"
    },
    {
      "type": "article", "id": "water_article", "label": "选择文章"
    },
    {
      "type": "richtext", "id": "water_description", "label": "自定义描述", "default": "<p>Explore the depths of water energy, governing our emotions, intuition, and subconscious mind.</p>"
    },
    {
      "type": "header", "content": "土元素 (Earth)"
    },
    {
      "type": "article", "id": "earth_article", "label": "选择文章"
    },
    {
      "type": "richtext", "id": "earth_description", "label": "自定义描述", "default": "<p>Understand how earth energy grounds us, providing stability, practicality, and connection to nature.</p>"
    },
    {
      "type": "header", "content": "风元素 (Air)"
    },
    {
      "type": "article", "id": "air_article", "label": "选择文章"
    },
    {
      "type": "richtext", "id": "air_description", "label": "自定义描述", "default": "<p>Learn about air energy's connection to our thoughts, communication style, and intellectual pursuits.</p>"
    },
    {
      "type": "header", "content": "布局设置"
    },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "顶部内边距", "default": 36 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "底部内边距", "default": 36 }
  ],
  "presets": [
    {
      "name": "四元素故事"
    }
  ]
}
{% endschema %}