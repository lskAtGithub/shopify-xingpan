<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.7.1/chart.js"></script>
<div id="report-container" class="report-page-container">
  <!-- Loading State -->
  <div id="report-loader">
    <p>Loading your report, please wait...</p>
  </div>

  <!-- Report content (hidden until loaded) -->
  <div id="report-content" style="display: none;">
    <!-- Top Bar -->
    <div class="report-header">
      <div class="report-info">
        <svg
          class="report-icon"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline>
        </svg>
        <div>
          <span class="report-for">Report for <strong id="report-user-name">...</strong></span>
          <span id="report-date" class="report-date">...</span>
        </div>
      </div>
      <a id="download-pdf-link" href="#" class="download-pdf-button" target="_blank">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
        <span>Download PDF</span>
      </a>
    </div>

    <!-- Main Report Content -->
    <div class="report-body">
      <!-- Black Info Box -->
      <div class="jason-report-box">
        <h2 id="report-user-name-box">...</h2>
        <p id="report-birthday">...</p>
        <p id="report-address">...</p>
      </div>

      <!-- Elemental Balance Chart -->
      <div class="elemental-balance-section">
        <h3>Elemental Balance</h3>
        <div class="chart-container">
          <div class="pie-chart-wrapper">
            <canvas id="elementalPieChart" width="200" height="200"></canvas>
          </div>
          <div id="chart-legend-container" class="chart-legend">
            <!-- Legend will be dynamically inserted here -->
          </div>
        </div>
      </div>

      {% comment %}
        <div class="report-table-wrapper">
          <h3 style="text-align: center;">Chart Details</h3>
          <div style="overflow-x: auto;-webkit-overflow-scrolling: touch;">
            <table class="report-details-table" id="report-details-table">
              <thead>
                <tr>
                  <th>Zodiac Sign</th>
                  <th>Planet</th>
                  <th>Domicile/Exaltation</th>
                  <th>Zodiac Element</th>
                  <th>Planet Element Score</th>
                  <th>Domicile/Exaltation Bonus</th>
                  <th>House the Planet is in</th>
                  <th>House Element</th>
                  <th>House Element Score</th>
                </tr>
              </thead>
              <tbody></tbody>
            </table>
          </div>
        </div>
      {% endcomment %}

      <div class="chart-details-wrapper page-width">
        <h3 class="chart-details-title">Chart Details</h3>

        <!-- The grid will be populated by JavaScript -->
        <div id="chart-details-grid" class="chart-details-grid"></div>
      </div>

      <!-- The main content from API -->
      <div id="report-dynamic-content" class="report-dynamic-content">
        <!-- The 'content' HTML from the API will be injected here -->
      </div>
    </div>
  </div>
</div>

<style>
  /* --- STYLES ARE UNCHANGED FROM THE PREVIOUS VERSION --- */
  #report-loader {
    text-align: center;
    padding: 100px 20px;
    font-size: 1.2em;
    color: #555;
  }
  .report-page-container {
