</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const loader = document.getElementById('report-loader');
    const content = document.getElementById('report-content');
    const container = document.getElementById('report-container');
    {% comment %} const tableBody = document.querySelector('#report-details-table tbody'); {% endcomment %}

    const API_BASE_URL = 'https://api.11starsastro.com';

    // A mapping for Chinese keys to English names and colors for the chart
    const elementMap = {
        '水': { name: 'Water', color: '#4A90E2' },
        '风': { name: 'Air', color: '#52B788' },
        '土': { name: 'Earth', color: '#8B5E34' },
        '火': { name: 'Fire', color: '#FFC914' }
    };

    const renderReport = (data) => {
        // --- 1. Parse the 'param' JSON string ---
        const params = JSON.parse(data.param).data;

        // --- 2. Populate Header and Info Box ---
        const reportDate = new Date(data.cTime).toLocaleString();
        document.getElementById('report-user-name').textContent = data.userName;
        document.getElementById('report-user-name-box').textContent = `${data.userName}'s Report`;
        document.getElementById('report-date').textContent = reportDate;
        document.getElementById('report-birthday').textContent = new Date(data.birthday).toLocaleString();
        document.getElementById('report-address').textContent = data.address;
        document.getElementById('download-pdf-link').href = API_BASE_URL + data.pdfPath;

        data.content = data.content.replace(/[\u4e00-\u9fa5]/g, '');
        document.getElementById('report-dynamic-content').innerHTML = data.content.replace('### Astrological Element Report  \n\n\n', '');
        const subtitleElementColors = [
          { name: 'Water Element', color: '#E5EFFB' },
          { name: 'Air Element', color: '#E5F3E5' },
          { name: 'Earth Element', color: '#EDE6DF' },
          { name: 'Fire Element', color: '#FEF8D9' }
        ];
        // --- 3. Inject the Main HTML Content ---
        const subTitleDiv = document.querySelectorAll('#report-dynamic-content .div2 .subtitle');
        subTitleDiv.forEach(div => { 
          subtitleElementColors.forEach(color => { 
            if(div.textContent.includes(color.name)) { 
              div.parentElement.style.backgroundColor = color.color; 
            }
          });
        });
        // --- 4. Prepare Data and Render the Pie Chart ---
        const scores = params.itemScore;
        const totalScore = Object.values(scores).reduce((sum, score) => sum + score, 0);

        const chartLabels = [];
        const chartData = [];
        const chartColors = [];
        let legendHTML = '';

        Object.entries(scores).forEach(([key, score]) => {
            const element = elementMap[key];
            if (element) {
                const percentage = totalScore > 0 ? ((score / totalScore) * 100).toFixed(2) : 0;
                chartLabels.push(element.name);
                chartData.push(percentage);
                chartColors.push(element.color);

                legendHTML += `
                    <div class="legend-item">
                        <span class="legend-color" style="background-color: ${element.color};"></span>
                        ${element.name}: ${percentage}%
                    </div>`;
            }
        });
        
        document.getElementById('chart-legend-container').innerHTML = legendHTML;

        const ctx = document.getElementById('elementalPieChart');
        const reportDetailsChart = new window.Chart(ctx, {
            type: 'pie',
            data: {
              labels: chartLabels,
              datasets: [{
                  label: '',
                  data: chartData,
                  backgroundColor: chartColors,
                  hoverOffset: 4
              }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    {% comment %} tooltip: {
                        callbacks: {
                            label: (context) => `${context.label}: ${context.parsed}%`
                        }
                    } {% endcomment %}
                }
            }
        });

        if(data.scoreMap) {
          renderContent(data.scoreMap)
        } else {
          gridContainer.innerHTML = `<p class="error-message">Could not load chart details. Please try again later.</p>`;
        }

        {% comment %} tableBody.innerHTML = '';
        if (params.list.length > 0) {
          
          params.list.forEach((item, index) => {
            const miaoWang =
              item.miao === 0 && item.wang === 0
                ? 'none'
                : (item.miao > 0 ? 'Domicile' : '') +
                  (item.miao > 0 && item.wang > 0 ? '/' : '') +
                  (item.wang > 0 ? 'Exalted' : '');

            const row = `
          <tr class="${index % 2 === 1 ? 'even-row' : ''}">
            <td>${item.constellation}</td>
            <td>${item.starName}</td>
            <td>${miaoWang}</td>
            <td>${item.zodiacSigns}</td>
            <td>${item.starScore}</td>
            <td>${item.miao + item.wang}</td>
            <td>${item.houses ? item.houses : '/'}</td>
            <td>${item.houses ? item.housesName : '/'}</td>
            <td>${item.houses ? item.housesScore : '/'}</td>
          </tr>`;
            tableBody.insertAdjacentHTML('beforeend', row);
          });
        } else {
          tableBody.innerHTML = `
        <tr>
          <td colspan="9" style="text-align: center; color: #999;">
            没有找到匹配的数据
          </td>
        </tr>`;
        } {% endcomment %}
    };
    const elementColors = {
      'Earth': { header: '#EEE6DF', border: '#EEE6DF' },
      'Air': { header: '#E4F3E5', border: '#E4F3E5' },
      'Water': { header: '#E4EFFB', border: '#E4EFFB' },
      'Fire': { header: '#FFF8D9', border: '#FFF8D9' },
      'default': { header: '#F0F0F0', border: '#DDDDDD' }
    };
    const gridContainer = document.getElementById(`chart-details-grid`);
    const generateMobileLayout = (scoreMap) => {
      let tableRows = '';
      const elementOrder = ['Earth', 'Air', 'Water', 'Fire'];
  
      elementOrder.forEach(elementName => {
        const scores = scoreMap[elementName];
        if (!scores || scores.length === 0) return;
        const colors = elementColors[elementName] || elementColors.default;
        
        scores.forEach((scoreObject, index) => {
          const [key, value] = Object.entries(scoreObject)[0];
          tableRows += '<tr>';
          if (index === 0) {
            tableRows += `<td class="element-cell" rowspan="${scores.length}" style="background-color: ${colors.header};">${elementName}</td>`;
          }
          tableRows += `<td>${capitalizeFirstLetter(key)}</td><td class="score-cell">${value}</td>`;
          tableRows += '</tr>';
        });
      });
  
      return `
        <table class="chart-details-table-mobile">
          <thead>
            <tr><th>Element</th><th>Zodiac Sign</th><th>Score</th></tr>
          </thead>
          <tbody>${tableRows}</tbody>
        </table>`;
    };
    const renderTables = (scoreMap) => {
      let html = '';
      
      // The order might not be guaranteed, so you can define it if needed.
      const elementOrder = ['Earth', 'Air', 'Water', 'Fire'];
      
      elementOrder.forEach(elementName => {
        const scores = scoreMap[elementName];
        if (!scores) return;
  
        const colors = elementColors[elementName] || elementColors.default;
        
        let tableRows = '';
        scores.forEach(scoreObject => {
          const [key, value] = Object.entries(scoreObject)[0];
          tableRows += `
            <tr>
              <td>${capitalizeFirstLetter(key)}</td>
              <td class="score-value">${value}</td>
            </tr>`;
        });
  
        html += `
          <div class="element-table-container">
            <table class="grid-element-table">
              <thead>
                <tr style="background-color: ${colors.header};">
                  <th colspan="2">${elementName}</th>
                </tr>
              </thead>
              <tbody>
                ${tableRows}
              </tbody>
            </table>
          </div>`;
      });
      
      // Clear the loader and inject the new HTML
      gridContainer.innerHTML = html;
    };

    const renderContent = (loadedData) => {
      if (!loadedData) return; // Don't render if data isn't loaded yet
      
      // Check screen size and render the correct layout
      if (window.matchMedia('(max-width: 768px)').matches) {
        gridContainer.innerHTML = generateMobileLayout(loadedData);
      } else {
        renderTables(loadedData);
      }
    };
  
    const capitalizeFirstLetter = (string) => {
      return string.charAt(0).toUpperCase() + string.slice(1);
    };

    const fetchReport = async () => {
        try {
            const urlParams = new URLSearchParams(window.location.search);
            const reportId = urlParams.get('id');

            if (!reportId) {
                throw new Error('Report ID is missing from the URL.');
            }

            const response = await fetch(`${API_BASE_URL}/report/getById?id=${reportId}`);
            if (!response.ok) {
                throw new Error(`API request failed with status ${response.status}`);
            }

            const result = await response.json();
            if (result.code !== 0) {
                throw new Error(result.message || 'An unknown API error occurred.');
            }
            
            renderReport(result.data);
            
            // Show content and hide loader
            loader.style.display = 'none';
            content.style.display = 'block';

        } catch (error) {
            console.error('Failed to load report:', error);
            container.innerHTML = `<div style="text-align: center; padding: 50px;"><h2>Could not load report</h2><p>${error.message}</p></div>`;
        }
    };

    fetchReport();
});
</script>

{% schema %}
{
  "name": "Main Report Detail",
  "tag": "section",
  "class": "section"
}
{% endschema %}
