      flex-direction: column;
    }
  }
  .report-table-wrapper {
    /* Smooth scrolling on iOS */
    margin: 2rem 0;
  }
  .report-table-wrapper .table-title {
    font-size: 1.5rem;
    color: #000000;
    font-weight: 600;
    margin-bottom: 1rem;
    text-align: center;
  }
  .report-details-table {
    width: 100%;
    min-width: 800px; /* Force scroll on small screens */
    border-collapse: collapse;
  }
  .report-details-table th,
  .report-details-table td {
    border: 1px solid #ddd;
