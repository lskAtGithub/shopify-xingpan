    margin-bottom: 1em;
  }
  .jason-report-box {
    background-color: #121212;
    color: #fff;
    padding: 30px;
    border-radius: 12px;
    text-align: center;
    margin-bottom: 40px;
  }
  .jason-report-box h2 {
    font-size: 28px;
    margin: 0 0 10px 0;
  }
