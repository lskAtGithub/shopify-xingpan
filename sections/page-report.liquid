{% comment %}
  Report Detail Page Section
  - Displays detailed report information based on report ID in URL
  - Includes customer authentication check
  - Shows loading, error, and not found states
{% endcomment %}

<div class="report-detail-page section-{{ section.id }}">
  <div class="page-width">

    {% if customer %}
      <!-- ============================================= -->
      <!-- ========= START: LOGGED IN VIEW ========= -->
      <!-- ============================================= -->
      <div id="report-detail-container" data-customer-id="{{ customer.id }}">
        <div class="report-detail-header">
          <div class="header-actions">
            <a href="/pages/report-list" class="button button--secondary back-button">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"></path></svg>
              Back to Reports
            </a>
          </div>
          <h1 id="report-title">Report Details</h1>
        </div>

        <!-- Loading Spinner -->
        <div id="loading-spinner" class="spinner-container">
          <div class="spinner"></div>
          <p>Loading your report...</p>
        </div>
        
        <!-- Report Not Found -->
        <div id="report-not-found" class="message-container" style="display: none;">
          <p>Report not found or you don't have permission to view it.</p>
          <a href="/pages/report-list" class="button">View All Reports</a>
        </div>
        
        <!-- Report Content -->
        <div id="report-content" class="report-content" style="display: none;">
          <!-- Report Header Info -->
          <div class="report-header-info">
            <div class="report-meta">
              <div class="meta-item">
                <span class="meta-label">Report ID:</span>
                <span id="report-id" class="meta-value"></span>
              </div>
              <div class="meta-item">
                <span class="meta-label">Generated:</span>
                <span id="report-date" class="meta-value"></span>
              </div>
            </div>
            <div class="report-actions">
              <a id="download-pdf" href="#" class="button button--secondary" download>
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                Download PDF
              </a>
            </div>
          </div>

          <!-- Report Data Sections -->
          <div class="report-sections">
            <!-- Personal Information -->
            <div class="report-section">
              <h2 class="section-title">Personal Information</h2>
              <div class="personal-info">
                <div class="info-grid">
                  <div class="info-item">
                    <span class="info-label">Name:</span>
                    <span id="user-name" class="info-value"></span>
                  </div>
                  <div class="info-item">
                    <span class="info-label">Birth Date:</span>
                    <span id="birth-date" class="info-value"></span>
                  </div>
                  <div class="info-item">
                    <span class="info-label">Birth Time:</span>
                    <span id="birth-time" class="info-value"></span>
                  </div>
                  <div class="info-item">
                    <span class="info-label">Birth Place:</span>
                    <span id="birth-place" class="info-value"></span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Core Analysis -->
            <div class="report-section">
              <h2 class="section-title">Core Analysis</h2>
              <div id="core-analysis" class="analysis-content">
                <!-- Will be populated by JavaScript -->
              </div>
            </div>

            <!-- Recommended Products -->
            <div class="report-section">
              <h2 class="section-title">Recommended Products</h2>
              <div id="recommended-products" class="products-grid">
                <!-- Will be populated by JavaScript -->
              </div>
            </div>
          </div>
        </div>
        
        <!-- Error Message -->
        <div id="error-message" class="message-container" style="display: none;"></div>
      </div>
      <!-- ============================================= -->
      <!-- ========= END: LOGGED IN VIEW ========= -->
      <!-- ============================================= -->

    {% else %}
      <!-- ============================================= -->
      <!-- ======= START: LOGGED OUT VIEW ======= -->
      <!-- ============================================= -->
      <div class="logged-out-container message-container">
        <p>You can view your report only after logging in to your account</p>
        <a href="/account/login" class="button">Log in now</a>
      </div>
      <!-- ============================================= -->
      <!-- ========= END: LOGGED OUT VIEW ======== -->
      <!-- ============================================= -->
    {% endif %}

  </div>
</div>

{% stylesheet %}
.report-detail-page {
  padding: 3rem 1rem;
}
.page-width {
  max-width: 1200px;
  margin: 0 auto;
}

/* --- Header Styles --- */
.report-detail-header {
  text-align: center;
  margin-bottom: 3rem;
}
.header-actions {
  margin-bottom: 1.5rem;
  text-align: left;
}
.back-button {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 0.9rem;
}
.report-detail-header h1 {
  font-size: 2.5rem;
  margin: 0;
}

/* --- Message & Loading Styles --- */
.message-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 4rem 1rem;
  background-color: #f9fafb;
  border-radius: 12px;
  min-height: 40vh;
}
.message-container p {
  font-size: 1.125rem;
  color: #555;
  margin: 0 0 1.5rem 0;
}

.spinner-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 40vh;
  gap: 1.5rem;
}
.spinner {
  width: 48px; height: 48px;
  border: 5px solid #f3f3f3;
  border-top: 5px solid #3498db;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}
@keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }

/* --- Button Styles --- */
.button {
  display: inline-block;
  padding: 0.75rem 1.5rem;
  border-radius: 8px;
  text-decoration: none;
  font-weight: 500;
  transition: all 0.2s ease;
  border: none;
  cursor: pointer;
  font-size: 1rem;
}
.button--primary {
  background: #2D3748;
  color: #fff;
}
.button--primary:hover {
  background-color: #1a202c;
}
.button--secondary {
  background: #fff;
  border: 1px solid #d1d5db;
  color: #333;
}
.button--secondary:hover {
  background-color: #f9fafb;
}

/* --- Report Content Styles --- */
.report-content {
  background-color: #fff;
  border-radius: 12px;
  overflow: hidden;
}

.report-header-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background-color: #f9fafb;
  padding: 1.5rem 2rem;
  border-bottom: 1px solid #e5e7eb;
  flex-wrap: wrap;
  gap: 1rem;
}

.report-meta {
  display: flex;
  gap: 2rem;
  flex-wrap: wrap;
}
.meta-item {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}
.meta-label {
  font-size: 0.875rem;
  color: #777;
}
.meta-value {
  font-weight: 500;
  color: #333;
}

/* --- Report Sections --- */
.report-sections {
  padding: 2rem;
}
.report-section {
  margin-bottom: 3rem;
}
.section-title {
  font-size: 1.5rem;
  margin: 0 0 1.5rem 0;
  padding-bottom: 0.5rem;
  border-bottom: 2px solid #e5e7eb;
  color: #2D3748;
}

/* --- Personal Info Grid --- */
.info-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 1.5rem;
}
.info-item {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}
.info-label {
  font-size: 0.875rem;
  color: #777;
  font-weight: 500;
}
.info-value {
  font-size: 1.125rem;
  color: #333;
}

/* --- Analysis Content --- */
.analysis-content {
  line-height: 1.6;
  color: #555;
}
.analysis-content p {
  margin-bottom: 1rem;
}
.analysis-content h3 {
  font-size: 1.25rem;
  margin: 1.5rem 0 1rem 0;
  color: #2D3748;
}

/* --- Products Grid --- */
.products-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 2rem;
}
.product-card {
  border: 1px solid #e5e7eb;
  border-radius: 8px;
  overflow: hidden;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}
.product-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1);
}
.product-image-container {
  height: 200px;
  overflow: hidden;
}
.product-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.3s ease;
}
.product-card:hover .product-image {
  transform: scale(1.05);
}
.product-details {
  padding: 1.5rem;
}
.product-title {
  font-size: 1.125rem;
  margin: 0 0 0.5rem 0;
  font-weight: 600;
}
.product-description {
  color: #777;
  font-size: 0.9rem;
  margin: 0 0 1rem 0;
  line-height: 1.5;
}
.product-price {
  font-weight: 600;
  color: #2D3748;
  margin: 0 0 1rem 0;
}
.product-link {
  display: inline-block;
  text-decoration: none;
  color: #2D3748;
  font-weight: 500;
  transition: color 0.2s ease;
}
.product-link:hover {
  color: #1a202c;
  text-decoration: underline;
}

/* --- Responsive Adjustments --- */
@media (max-width: 768px) {
  .report-header-info {
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }
  
  .report-meta {
    flex-direction: column;
    gap: 1rem;
  }
  
  .report-sections {
    padding: 1.5rem;
  }
  
  .info-grid {
    grid-template-columns: 1fr;
  }
}
{% endstylesheet %}

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const container = document.getElementById('report-detail-container');
    if (!container) return; // Exit if not logged in

    // Get report ID from URL parameter
    const urlParams = new URLSearchParams(window.location.search);
    const reportId = urlParams.get('id');
    
    if (!reportId) {
      showNotFound();
      return;
    }

    const customerId = container.dataset.customerId;
    const reportTitle = document.getElementById('report-title');
    const reportContent = document.getElementById('report-content');
    const loadingSpinner = document.getElementById('loading-spinner');
    const reportNotFound = document.getElementById('report-not-found');
    const errorMessage = document.getElementById('error-message');
    const downloadPdf = document.getElementById('download-pdf');
    
    // Element references for report data
    const reportIdEl = document.getElementById('report-id');
    const reportDateEl = document.getElementById('report-date');
    const userNameEl = document.getElementById('user-name');
    const birthDateEl = document.getElementById('birth-date');
    const birthTimeEl = document.getElementById('birth-time');
    const birthPlaceEl = document.getElementById('birth-place');
    const coreAnalysisEl = document.getElementById('core-analysis');
    const recommendedProductsEl = document.getElementById('recommended-products');

    const BASE_URL = 'https://api.11starsastro.com';

    async function fetchReportDetails() {
      try {
        // Fetch report details by ID
        const response = await fetch(`${BASE_URL}/report/getById?id=${reportId}&key=${customerId}`);
        
        if (!response.ok) {
          throw new Error(`API Error: ${response.status} ${response.statusText}`);
        }

        const result = await response.json();
        
        loadingSpinner.style.display = 'none';

        if (result.code === 0 && result.data) {
          // Display report content
          reportContent.style.display = 'block';
          populateReportData(result.data);
        } else {
          showNotFound();
        }

      } catch (error) {
        console.error('Failed to fetch report details:', error);
        loadingSpinner.style.display = 'none';
        errorMessage.textContent = 'Sorry, we couldn\'t load your report at this time. Please try again later.';
        errorMessage.style.display = 'block';
      }
    }

    function showNotFound() {
      loadingSpinner.style.display = 'none';
      reportNotFound.style.display = 'flex';
    }

    function populateReportData(report) {
      // Set basic report information
      reportTitle.textContent = `${report.userName || 'Report'} - Details`;
      reportIdEl.textContent = report.id;
      reportDateEl.textContent = new Date(report.cTime).toLocaleString();
      
      // Set personal information
      userNameEl.textContent = report.userName || 'N/A';
      
      // Parse birth date/time
      if (report.birthday) {
        const dateParts = report.birthday.split(' ');
        birthDateEl.textContent = dateParts[0] || 'N/A';
        birthTimeEl.textContent = dateParts.length > 1 ? dateParts[1] : 'N/A';
      } else {
        birthDateEl.textContent = 'N/A';
        birthTimeEl.textContent = 'N/A';
      }
      
      birthPlaceEl.textContent = report.address || 'N/A';
      
      // Set PDF download link
      if (report.pdfPath) {
        downloadPdf.href = report.pdfPath;
      }
      
      // Populate core analysis (customize based on your report data structure)
      coreAnalysisEl.innerHTML = `
        <p>This is a detailed analysis based on the astrological data provided. The report includes insights about personality traits, strengths, challenges, and life path guidance.</p>
        
        <h3>Key Insights</h3>
        <p>The analysis reveals important patterns in your astrological chart that influence various aspects of your life. These insights can help you understand your natural tendencies and make more informed decisions.</p>
        
        <h3>Recommendations</h3>
        <p>Based on your astrological profile, we've provided personalized recommendations to help you navigate life's challenges and opportunities.</p>
      `;
      
      // Populate recommended products
      if (report.scoreProductMap && Object.keys(report.scoreProductMap).length > 0) {
        recommendedProductsEl.innerHTML = '';
        
        Object.values(report.scoreProductMap).forEach(product => {
          const productCard = document.createElement('div');
          productCard.className = 'product-card';
          productCard.innerHTML = `
            <div class="product-image-container">
              <img src="${product.image || '/assets/placeholder-image.png'}" alt="${product.title}" class="product-image">
            </div>
            <div class="product-details">
              <h3 class="product-title">${product.title}</h3>
              <p class="product-description">${product.bodyHtml || 'No description available'}</p>
              <p class="product-price">$${product.price || 129}</p>
              <a href="/products/${product.handle || '#'}" class="product-link" target="_blank">View Product</a>
            </div>
          `;
          recommendedProductsEl.appendChild(productCard);
        });
      } else {
        recommendedProductsEl.innerHTML = '<p class="message-container">No recommended products available for this report.</p>';
      }
    }

    // Start fetching report details
    fetchReportDetails();
  });
</script>

{% schema %}
  {
    "name": "Report Detail Page",
    "settings": []
  }
{% endschema %}