<script>
  let orderNo = '';
  document.addEventListener('DOMContentLoaded', () => {
    const pageContainer = document.querySelector('.order-report-page');
    if (!pageContainer) return;

    const customerId = pageContainer.dataset.customerId;
    const baseUrl = 'https://api.11starsastro.com';
    const API_ENDPOINT = baseUrl + '/order/getOrderList';
    const ITEMS_PER_PAGE = 10;

    // --- State Management for Pagination ---
    let currentPage = 1;
    let pageInfoHistory = ['']; // History of pageInfo tokens. First page is empty.
    let hasNextPage = false;
    let allOrders = []; // Cache all fetched orders to avoid re-fetching

    // --- DOM Element References ---
    const loader = document.querySelector('.loading-spinner');
    const listContainer = document.querySelector('.order-list-container');
    const tableBody = document.querySelector('.order-table-body');
    const cardList = document.querySelector('.order-card-list');
    const emptyStateContainer = document.querySelector('.empty-state-container');
    const paginationContainer = document.querySelector('.pagination-wrapper');

    // --- NEW Pagination UI Rendering ---
    const renderPagination = () => {
      paginationContainer.innerHTML = `
        <button class="pagination-button" id="prev-page" aria-label="Previous page">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
        </button>
        <button class="pagination-button" id="next-page" aria-label="Next page">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </button>
      `;

      const prevButton = document.getElementById('prev-page');
      const nextButton = document.getElementById('next-page');

      prevButton.disabled = currentPage <= 1;
      nextButton.disabled = !hasNextPage;

      // Show pagination only if there's more than one page (either past or future)
      paginationContainer.style.display = currentPage > 1 || hasNextPage ? 'flex' : 'none';
    };

    // --- REFACTORED API Fetch Function ---
    const fetchOrders = async (direction) => {
      loader.style.display = 'flex';
      listContainer.style.display = 'none';
      paginationContainer.style.display = 'none';

      let pageInfoToSend = '';

      if (direction === 'next') {
        pageInfoToSend = pageInfoHistory[currentPage] || '';
        currentPage++;
      } else if (direction === 'prev') {
        currentPage--;
        pageInfoToSend = pageInfoHistory[currentPage - 1] || '';
      } else {
        // Initial load
        currentPage = 1;
        pageInfoHistory = [''];
      }

      try {
        // Build the URL with pageInfo if it exists
        let url = `${API_ENDPOINT}?customerId=${customerId}&limit=${ITEMS_PER_PAGE}`;
        if (pageInfoToSend) {
          url += `&pageInfo=${encodeURIComponent(pageInfoToSend)}`;
        }

        const response = await fetch(url, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
        });

        if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);
        const result = await response.json();
        if (result.code !== 0) throw new Error(result.message || 'API returned an error');

        const orders = result.data.orders || [];
        const nextPageInfo = result.data.pageInfo;

        hasNextPage = !!nextPageInfo; // If pageInfo exists, there is a next page

        if (hasNextPage) {
          // Store the token for the *next* page at the *current* page's index
          pageInfoHistory[currentPage] = nextPageInfo;
        }

        if (orders.length === 0 && currentPage === 1) {
          emptyStateContainer.style.display = 'block';
        } else {
          emptyStateContainer.style.display = 'none';
          listContainer.style.display = 'block';
          renderOrders(orders); // Re-render with the new page's data
          renderPagination();
        }
      } catch (error) {
        console.error('Failed to fetch orders:', error);
        listContainer.style.display = 'none';
        emptyStateContainer.style.display = 'block';
      } finally {
        loader.style.display = 'none';
      }
    };

    // --- NEW Event Listeners ---
    paginationContainer.addEventListener('click', (event) => {
      const button = event.target.closest('.pagination-button');
      if (!button || button.disabled) return;

      if (button.id === 'next-page') {
        fetchOrders('next');
      } else if (button.id === 'prev-page') {
        // For prev, we don't need to re-fetch if we cache data.
        // But for cursor pagination, we MUST re-fetch with the previous page's cursor.
        fetchOrders('prev');
      }
    });

    // --- Initial Load ---
    fetchOrders('initial');

    // --- Helper function copies (to make the script standalone) ---
    const getOrderStatus = (order) => {
      if (order.cancelled_at) return 'Canceled';
      return order.fulfillment_status ? 'Fulfilled' : 'UnFulfilled';
    };
    const getStatusBadge = (statusText) => {
      const statusClass = `status--${statusText.toLowerCase()}`;
      return `<span class="status-badge ${statusClass}">${statusText}</span>`;
    };
    const getActionButton = (order) => {
      const status = getOrderStatus(order);
      if (order.report_url) {
        return `<a href="${order.report_url}" class="action-button primary">View Report</a>`;
      }
      if (status === 'Fulfilled') {
        return `<button class="action-button primary get-report-btn" data-order-id="${order.id}">Get the in-depth report</button>`;
      }
      return `<button class="action-button disabled" disabled>Get the in-depth report</button>`;
    };
    const renderOrders = (orders) => {
      tableBody.innerHTML = '';
      cardList.innerHTML = '';
      orders.forEach((order) => {
        const statusText = getOrderStatus(order);
        const orderData = {
          number: order.name,
          date: order.created_at
            ? new Date(order.created_at).toLocaleDateString('en-US', {
                month: 'short',
                day: 'numeric',
                year: 'numeric',
              })
            : 'N/A',
          customer:
            (order.customer && `${order.customer.first_name || ''} ${order.customer.last_name || ''}`.trim()) ||
            'Liam Johnson',
          total: `$${parseFloat(order.current_total_price).toFixed(2)}`,
          status: statusText,
        };
        const tableRow = `<tr><td>${orderData.number}</td><td>${orderData.date}</td><td>${orderData.customer}</td><td>${
          orderData.total
        }</td><td>${getStatusBadge(orderData.status)}</td><td>${getActionButton(order)}</td></tr>`;
        tableBody.insertAdjacentHTML('beforeend', tableRow);
        const mobileCard = `<div class="order-card"><span class="order-number">${
          orderData.number
        }</span>${getStatusBadge(orderData.status)}<span class="customer-name">${
          orderData.customer
        }</span><span class="total-price">${orderData.total}</span><span class="order-date">${
          orderData.date
        }</span>${getActionButton(order)}</div>`;
        cardList.insertAdjacentHTML('beforeend', mobileCard);
      });
    };

    window.customer = {% if customer %}
      {
        "id": {{ customer.id | json }} || '',
        "email": {{ customer.email | json }},
        "first_name": {{ customer.first_name | json }},
        "last_name": {{ customer.last_name | json }},
        "phone": {{ customer.phone | json }},
        "tags": {{ customer.tags | json }},
        "orders_count": {{ customer.orders_count | json }},
        "total_spent": {{ customer.total_spent | json }},
        "accepts_marketing": {{ customer.accepts_marketing | json }},
        "addresses": {{ customer.addresses | json }},
        "default_address": {{ customer.default_address | json }}
      }
      {% else %}
        null
      {% endif %};
    let lat = '';
    let lon = '';
    let reportId = '';
    const BASE_URL = 'https://api.11starsastro.com';
    const countrySelect = document.getElementById('country');
      const stateSelect = document.getElementById('state');
      const spinner = document.getElementById('loading-spinner');
      const citySelect = document.getElementById('city');

      const API_URL = BASE_URL + '/city/getInfo';


      const PLACEHOLDERS = {
        country: 'Select Country',
        state: 'Select State/Province',
        city: 'Select City',
      };

      function createOption(text, value = '') {
        const opt = document.createElement('option');
        opt.value = value;
        opt.textContent = text;
        return opt;
      }

      function resetSelect(select, placeholder) {
        select.innerHTML = '';
        select.appendChild(createOption(placeholder, ''));
        select.disabled = true;
      }

      function setLoading(select) {
        select.innerHTML = '';
        select.appendChild(createOption('Loading...', ''));
        select.disabled = true;
      }

      function populateSelectWithObjects(select, items, textKey = 'name', valueKey = 'id') {
        select.innerHTML = '';
        select.appendChild(
          createOption(
            select === countrySelect
              ? PLACEHOLDERS.country
              : select === stateSelect
              ? PLACEHOLDERS.state
              : PLACEHOLDERS.city,
            ''
          )
        );
        if (!items || !items.length) {
          select.disabled = true;
          return;
        }
        items.forEach((item) => {
          const text = (item && (item[textKey] || item.name || String(item))) || '';
          const value =
            (item && (item[valueKey] !== undefined ? item[valueKey] : item.id !== undefined ? item.id : item)) || '';
          const opt = createOption(text, value);
          select.appendChild(opt);
          opt.dataset.latitude = item.latitude;
          opt.dataset.longitude = item.longitude;
        });
        select.disabled = false;
      }

      async function fetchFromApi(params = {}) {
        // 构造带查询串的 URL
        const url = new URL(API_URL);
        Object.keys(params).forEach((k) => {
          if (params[k] !== undefined && params[k] !== null && params[k] !== '') url.searchParams.append(k, params[k]);
        });

        try {
          const res = await fetch(url.toString(), { method: 'GET', mode: 'cors' });
          if (!res.ok) {
            throw new Error('HTTP ' + res.status);
          }
          const json = await res.json();
          // 兼容：返回包裹 { code, message, data: [...] } 的情形
          if (json && Array.isArray(json.data)) {
            return json.data;
          }
          // 有些接口可能直接返回数组
          if (Array.isArray(json)) {
            return json;
          }
          // 兜底返回空数组
          return [];
        } catch (err) {
          return [];
        }
      }

      // 初始化日期时间选择器的范围和语言
      const birthDateTimeInput = document.getElementById('birth-datetime');
      if (birthDateTimeInput) {
        // 设置最大值为当前时间
        const now = new Date();
        const year = now.getFullYear();
        const month = String(now.getMonth() + 1).padStart(2, '0');
        const day = String(now.getDate()).padStart(2, '0');
        const hours = String(now.getHours()).padStart(2, '0');
        const minutes = String(now.getMinutes()).padStart(2, '0');
        const maxDateTime = `${year}-${month}-${day}T${hours}:${minutes}`;
        birthDateTimeInput.max = maxDateTime;
        
        // 设置最小值为1900年1月1日
        birthDateTimeInput.min = '1900-01-01T00:00';
        
        // 尝试设置语言环境为英文
        try {
          // 对于支持该属性的浏览器
          birthDateTimeInput.setAttribute('lang', 'en');
          birthDateTimeInput.setAttribute('data-locale', 'en-US');
          
          // 尝试通过Intl API设置日期格式
          const options = { 
            year: 'numeric', 
            month: '2-digit', 
            day: '2-digit',
            hour: '2-digit',
            minute: '2-digit',
            hour12: false
          };
          const formatter = new Intl.DateTimeFormat('en-US', options);
          
          // 添加事件监听器，确保选择器使用英文
          birthDateTimeInput.addEventListener('focus', function() {
            this.setAttribute('lang', 'en');
          });
          
          birthDateTimeInput.addEventListener('click', function() {
            this.setAttribute('lang', 'en');
          });
          
          // 添加额外的点击事件监听器，强制触发日期选择器
          birthDateTimeInput.addEventListener('click', function() {
            // 确保元素已聚焦
            this.focus();
            
            // 使用现代浏览器支持的showPicker方法
            if (typeof this.showPicker === 'function') {
              try {
                this.showPicker();
              } catch (e) {
                // 忽略可能的错误，如在某些设备上showPicker可能不被支持
                console.log('showPicker method failed:', e);
              }
            }
          });
          
          // 添加触摸事件支持，针对移动设备
          birthDateTimeInput.addEventListener('touchstart', function(e) {
            e.preventDefault(); // 防止滚动
            this.focus();
            
            if (typeof this.showPicker === 'function') {
              try {
                this.showPicker();
              } catch (e) {
                console.log('Touch showPicker failed:', e);
              }
            }
          }, { passive: false });
        } catch (e) {
          console.log('Could not set locale for datetime input:', e);
        }
      }
      
      // 初始化：清空下级
      resetSelect(stateSelect, PLACEHOLDERS.state);
      resetSelect(citySelect, PLACEHOLDERS.city);

      // 加载国家列表（页面加载时）
      (async function loadCountries() {
        setLoading(countrySelect);
        const countries = await fetchFromApi(); // 不传参数 => 返回国家列表
        populateSelectWithObjects(countrySelect, countries, 'name', 'id');
      })();

      // 当国家改变时，加载州/省
      countrySelect.addEventListener('change', async function () {
        const countryId = this.value;
        // 清空州和市
        resetSelect(stateSelect, PLACEHOLDERS.state);
        resetSelect(citySelect, PLACEHOLDERS.city);
        if (!countryId) return;

        setLoading(stateSelect);
        const states = await fetchFromApi({ countryId: countryId });
        const opt = this.options[this.selectedIndex];
        lat = opt.dataset.latitude;
        lon = opt.dataset.longitude;
        populateSelectWithObjects(stateSelect, states, 'name', 'id');
      });

      // 当州/省改变时，加载城市
      stateSelect.addEventListener('change', async function () {
        const stateId = this.value;
        const countryId = countrySelect.value;
        resetSelect(citySelect, PLACEHOLDERS.city);
        if (!countryId || !stateId) return;
        const opt = this.options[this.selectedIndex];
        lat = opt.dataset.latitude;
        lon = opt.dataset.longitude;
        setLoading(citySelect);
        const cities = await fetchFromApi({ countryId: '', stateId: stateId });
        populateSelectWithObjects(citySelect, cities, 'name', 'id');
      });
      citySelect.addEventListener('change', async function () {
        const opt = this.options[this.selectedIndex];
        lat = opt.dataset.latitude;
        lon = opt.dataset.longitude;
      });
      //  提交表单
      const form = document.querySelector('#report-form');
      let myChart = null;
      form.addEventListener('submit', async function (e) {
        e.preventDefault();
        const name = document.getElementById('name').value.trim();
        const birthDateTime = document.getElementById('birth-datetime').value;
        const country = document.getElementById('country').value;
        const state = document.getElementById('state').value;
        const city = document.getElementById('city').value;
        
        // 获取label文本内容
        const countryLabel = countrySelect.options[countrySelect.selectedIndex]?.text || '';
        const stateLabel = stateSelect.options[stateSelect.selectedIndex]?.text || '';
        const cityLabel = citySelect.options[citySelect.selectedIndex]?.text || '';
        
        // 验证必填字段
        if (!name) {
          alert('Please enter your full name');
          return false;
        }
        
        if (!birthDateTime) {
          alert('Please select your birth date and time');
          return false;
        }
        
        if (!country || !state || !city) {
          alert('Please select your birth location');
          return false;
        }
        
        // 将datetime-local格式转换为所需的格式
        const date = new Date(birthDateTime);
        const year = date.getFullYear();
        const month = String(date.getMonth() + 1).padStart(2, '0');
        const day = String(date.getDate()).padStart(2, '0');
        const hour = String(date.getHours()).padStart(2, '0');
        const minute = String(date.getMinutes()).padStart(2, '0');
        const time = `${year}-${month}-${day} ${hour}:${minute}:00`;
        const address = cityLabel ? `${cityLabel},${stateLabel},${countryLabel}` : `${stateLabel},${countryLabel}`;
        const payload = {
          tid: 7,
          us: 'en',
          userBirthday: time,
          userCity: address,
          userEmail: window.customer ? window.customer.email : '',
          ztime: 8,
          lat: lat,
          lon: lon,
          userName: name,
          orderNo,
        };
        if(window.customer && window.customer.id) {
          payload.key = ''; //window.customer.id;
        }
        const paramsForm = new URLSearchParams();
        Object.keys(payload).forEach((k) => {
          paramsForm.append(k, payload[k]);
        });
        spinner.style.display = 'flex';
        try {
          const res = await fetch(`${BASE_URL}/sysUser/creatReport`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/x-www-form-urlencoded',
            },
            body: paramsForm,
          });
          const data = await res.json();
          reportId = data.data.reportId;
          const reportTitle = document.getElementById('reportTitle');
          reportTitle.innerHTML = '';
          reportTitle.innerHTML = `${name}'s Report`;
          const reportDatetime = document.getElementById('reportDatetime');
          reportDatetime.innerHTML = '';
          reportDatetime.innerHTML = `${time}`;
          const reportAddress = document.getElementById('reportAddress');
          reportAddress.innerHTML = '';
          reportAddress.innerHTML = `${address}`;
          const container = document.getElementById('recommended-products');
          container.innerHTML  = '';
          if(myChart && myChart instanceof window.Chart) {
            myChart.destroy();
          }
          {% comment %} renderModal(data.data); {% endcomment %}
        } catch (err) {
          alert('请求失败，请稍后再试');
        }
        return false;
      });
      const reportFormEle = document.getElementById('report-form-element');
      const getReportBtn = document.querySelectorAll('.get-report-btn');
      getReportBtn.forEach((button) => {
        button.addEventListener('click', () => {
          orderNo = button.dataset.orderId;
          reportFormEle.style.display = 'flex';
        });
      });
  });
</script>

