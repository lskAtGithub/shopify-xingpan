          <path id="Vector_5" d="M36.2323 28.7572L38.3656 26.6239C38.579 26.4106 38.579 26.0692 38.3656 25.8559L34.3123 21.8026C34.099 21.5892 33.7576 21.5892 33.5443 21.8026L31.411 23.9359C31.1976 24.1492 31.1976 24.4906 31.411 24.7039L35.4643 28.7572C35.6776 28.9706 36.019 28.9706 36.2323 28.7572Z" fill="#2C2C2C"/>
