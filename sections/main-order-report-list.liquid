{% else %}
  <div class="page-width order-report-page" data-customer-id="{{ customer.id }}">
    <!-- 1. 顶部通知栏 -->
    <div class="order-report-notification" style="display: none;">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"></path><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"></path>
      </svg>
      <span>You can get a professional in-depth report when your order is confirmed</span>
    </div>

    <!-- 2. 加载状态 Spinner -->
    <div class="loading-spinner" style="display: none;">
      <div class="spinner"></div>
    </div>

    <!-- 3. 订单列表容器 (JS 将在此处填充内容) -->
    <div class="order-list-container">
      <!-- PC Table View (initially empty) -->
      <table class="order-table responsive-table">
        <thead class="responsive-table-header">
          <tr>
            <th>Order number</th>
            <th>Date</th>
            <th>Customer</th>
            <th>Total</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody class="order-table-body"></tbody>
      </table>

      <!-- Mobile Card View (initially empty) -->
      <div class="order-card-list"></div>
    </div>

    <!-- 4. 分页容器 (JS 将在此处填充内容) -->
    <nav class="pagination-wrapper" style="display: none;"></nav>

    <!-- 5. 空状态 (默认隐藏) -->
    <div class="empty-state-container" style="display: none;">
