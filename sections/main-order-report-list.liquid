{% comment %}
  确保用户已登录
{% endcomment %}
{% unless customer %}
  <div class="page-width center">
    <h1 class="h2">Please log in</h1>
    <p>You must be logged in to view your reports.</p>
    <a href="{{ routes.account_login_url }}" class="button">Log In</a>
  </div>
{% else %}
  <div class="page-width order-report-page" data-customer-id="{{ customer.id }}">
    
    <!-- 1. 顶部通知栏 -->
    <div class="order-report-notification">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"></path><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"></path></svg>
      <span>You can get a professional in-depth report when your order is confirmed</span>
    </div>

    <!-- 2. 加载状态 Spinner -->
    <div class="loading-spinner" style="display: none;">
      <div class="spinner"></div>
    </div>
    
    <!-- 3. 订单列表容器 (JS 将在此处填充内容) -->
    <div class="order-list-container">
      <!-- PC Table View (initially empty) -->
      <table class="order-table responsive-table">
        <thead class="responsive-table-header">
          <tr>
            <th>Order number</th>
            <th>Date</th>
            <th>Customer</th>
            <th>Total</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody class="order-table-body"></tbody>
      </table>
      
      <!-- Mobile Card View (initially empty) -->
      <div class="order-card-list"></div>
    </div>

    <!-- 4. 分页容器 (JS 将在此处填充内容) -->
    <nav class="pagination-wrapper" style="display: none;"></nav>

    <!-- 5. 空状态 (默认隐藏) -->
    <div class="empty-state-container" style="display: none;">
      <div class="empty-state-content">
        <img src="data:image/svg+xml;base64, " alt="Star icon" class="empty-state-icon">
        <p class="empty-state-text">You don’t have an energy report yet, go test it</p>
        <a href="/pages/test-page" class="button empty-state-button">Go test</a>
      </div>
    </div>
  </div>
{% endunless %}

<style>
  .order-report-page { max-width: 1200px; margin: 0 auto; padding: 20px; }
  .order-report-notification { display: flex; align-items: center; justify-content: center; background-color: #f0f5ff; border: 1px solid #d6e4ff; color: #595959; padding: 12px; border-radius: 8px; margin-bottom: 24px; font-size: 14px; }
  .order-report-notification svg { margin-right: 8px; }

  /* Table Styles */
  .order-table { width: 100%; border-collapse: collapse; border: 1px solid #e8e8e8; border-radius: 8px; overflow: hidden; }
  .order-table th, .order-table td { padding: 16px; text-align: left; }
  .order-table thead { background-color: #fafafa; }
  .order-table th { color: #595959; font-weight: 500; }
  .order-table tbody tr { border-top: 1px solid #e8e8e8; }
  .order-table tbody tr:hover { background-color: #f9f9f9; }

  /* Status Badges */
  .status-badge { padding: 4px 10px; border-radius: 12px; font-size: 12px; font-weight: 500; text-align: center; }
  .status--fulfilled { background-color: #e6f7ff; color: #1890ff; }
  .status--unfulfilled { background-color: #fffbe6; color: #faad14; }
  .status--canceled { background-color: #fff1f0; color: #f5222d; }
  
  /* Action Buttons */
  .action-button { padding: 8px 16px; border-radius: 6px; border: 1px solid transparent; cursor: pointer; font-weight: 500; transition: all 0.3s; }
  .action-button.primary { background-color: #2c2c2c; color: #fff; }
  .action-button.primary:hover { opacity: 0.8; }
  .action-button.disabled { background-color: #d9d9d9; color: #8c8c8c; cursor: not-allowed; }
  
  /* Mobile Card List */
  .order-card-list { display: none; flex-direction: column; gap: 16px; }
  .order-card { background-color: #fff; border: 1px solid #e8e8e8; border-radius: 8px; padding: 16px; display: grid; grid-template-areas: "number status" "customer price" "date date" "action action"; grid-template-columns: 1fr auto; gap: 8px 16px; }
  .order-card .order-number { grid-area: number; font-weight: 600; font-size: 16px; }
  .order-card .status-badge { grid-area: status; justify-self: end; }
  .order-card .customer-name { grid-area: customer; color: #595959; }
  .order-card .total-price { grid-area: price; font-weight: 600; font-size: 18px; justify-self: end; }
  .order-card .order-date { grid-area: date; color: #8c8c8c; font-size: 14px; }
  .order-card .action-button { grid-area: action; width: 100%; text-align: center; margin-top: 8px; }

  /* Empty State */
  .empty-state-container { padding: 60px 20px; text-align: center; }
  .empty-state-content { max-width: 400px; margin: 0 auto; }
  .empty-state-icon { margin-bottom: 24px; width: 72px; height: 72px; }
  .empty-state-text { font-size: 18px; color: #595959; margin-bottom: 24px; }
  .empty-state-button { background-color: #2c2c2c; color: #fff; padding: 12px 24px; }

  /* Pagination */
  .pagination-wrapper { display: flex; justify-content: center; margin-top: 32px; }
  .pagination-button { padding: 8px 14px; margin: 0 4px; border: 1px solid #d9d9d9; background-color: #fff; border-radius: 6px; cursor: pointer; }
  .pagination-button:hover { border-color: #1890ff; color: #1890ff; }
  .pagination-button.active { background-color: #1890ff; color: #fff; border-color: #1890ff; }
  .pagination-button:disabled { cursor: not-allowed; opacity: 0.5; }

  /* Loading Spinner */
  .loading-spinner { display: flex; justify-content: center; padding: 50px; }
  .spinner { border: 4px solid #f3f3f3; border-top: 4px solid #3498db; border-radius: 50%; width: 40px; height: 40px; animation: spin 1s linear infinite; }
  @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }

  /* Responsive Breakpoints */
  /* Hide table on mobile */
  @media (max-width: 768px) {
    .order-table { display: none; }
    .order-card-list { display: flex; }
  }
  /* Show table on screens larger than mobile */
  @media (min-width: 769px) {
    .order-table { display: table; }
    .order-card-list { display: none; }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const pageContainer = document.querySelector('.order-report-page');
    if (!pageContainer) return;
  
    const customerId = pageContainer.dataset.customerId;
    const BASE_URL = 'https://api.11starsastro.com';
    const API_ENDPOINT = BASE_URL + '/order/getOrderList'; // 确保这个路径正确
    const ITEMS_PER_PAGE = 10;
  
    // 获取所有DOM元素的引用
    const loader = document.querySelector('.loading-spinner');
    const listContainer = document.querySelector('.order-list-container');
    const tableBody = document.querySelector('.order-table-body');
    const cardList = document.querySelector('.order-card-list');
    const emptyStateContainer = document.querySelector('.empty-state-container');
    const paginationContainer = document.querySelector('.pagination-wrapper');
  
    // --- 帮助函数 (Helper Functions) ---
  
    // 根据履约和取消状态获取标准化的状态文本
    const getOrderStatus = (order) => {
      if (order.cancelled_at) {
        return 'Canceled';
      }
      // `fulfillment_status` can be null, which we treat as Unfulfilled
      return order.fulfillment_status ? 'Fulfilled' : 'UnFulfilled'; 
    };
  
    // 生成状态徽章的HTML
    const getStatusBadge = (statusText) => {
      // 统一处理大小写，以确保class匹配
      const statusClass = `status--${statusText.toLowerCase()}`;
      return `<span class="status-badge ${statusClass}">${statusText}</span>`;
    };
    
    // 根据订单状态生成操作按钮的HTML
    const getActionButton = (order) => {
      const status = getOrderStatus(order);
  
      // 假设您有一个字段叫 `report_url`，如果报告已生成
      if (order.report_url) { 
          return `<a href="${order.report_url}" class="action-button primary">View Report</a>`;
      }
      
      if (status === 'Fulfilled') {
          return `<button class="action-button primary" data-order-id="${order.id}">Get the in-depth report</button>`;
      }
  
      return `<button class="action-button disabled" disabled>Get the in-depth report</button>`;
    };
  
    // --- 渲染函数 (Rendering Functions) ---
    
    const renderOrders = (orders) => {
      tableBody.innerHTML = '';
      cardList.innerHTML = '';
  
      if (!orders || orders.length === 0) {
        listContainer.style.display = 'none';
        emptyStateContainer.style.display = 'block';
        return;
      }
  
      listContainer.style.display = 'block';
      emptyStateContainer.style.display = 'none';
  
      orders.forEach(order => {
        // **【核心对接区】**
        // 将API数据映射到我们需要的变量
        const statusText = getOrderStatus(order);
        const orderData = {
          id: order.id,
          number: order.name, // e.g., "#1001"
          // 格式化日期，并处理可能的无效日期
          date: order.created_at ? new Date(order.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : 'N/A',
          // 客户姓名: API中未提供，暂时留空或使用占位符
          customer: (order.customer && `${order.customer.first_name || ''} ${order.customer.last_name || ''}`.trim()) || 'Liam Johnson', // 使用UI图中的占位符
          total: `$${parseFloat(order.current_total_price).toFixed(2)}`, // e.g., "$99.01"
          status: statusText
        };
        
        // 渲染表格行
        const tableRow = `
          <tr>
            <td>${orderData.number}</td>
            <td>${orderData.date}</td>
            <td>${orderData.customer}</td>
            <td>${orderData.total}</td>
            <td>${getStatusBadge(orderData.status)}</td>
            <td>${getActionButton(order)}</td>
          </tr>`;
        tableBody.insertAdjacentHTML('beforeend', tableRow);
  
        // 渲染移动端卡片
        const mobileCard = `
          <div class="order-card">
            <span class="order-number">${orderData.number}</span>
            ${getStatusBadge(orderData.status)}
            <span class="customer-name">${orderData.customer}</span>
            <span class="total-price">${orderData.total}</span>
            <span class="order-date">${orderData.date}</span>
            ${getActionButton(order)}
          </div>`;
        cardList.insertAdjacentHTML('beforeend', mobileCard);
      });
    };
  
    const renderPagination = (totalCount, currentPage) => {
      paginationContainer.innerHTML = '';
      if (!totalCount) {
          paginationContainer.style.display = 'none';
          return;
      }
      const totalPages = Math.ceil(totalCount / ITEMS_PER_PAGE);
  
      if (totalPages <= 1) {
          paginationContainer.style.display = 'none';
          return;
      }
      paginationContainer.style.display = 'flex';
        
      for (let i = 1; i <= totalPages; i++) {
          const button = document.createElement('button');
          button.textContent = i;
          button.className = `pagination-button ${i === currentPage ? 'active' : ''}`;
          button.dataset.page = i;
          paginationContainer.appendChild(button);
      }
    };
  
    // --- API 获取函数 (API Fetch Function) ---
    
    const fetchOrders = async (page = 1) => {
      loader.style.display = 'flex';
      listContainer.style.display = 'none';
      emptyStateContainer.style.display = 'none';
      paginationContainer.style.display = 'none';
  
      try {
        const response = await fetch(`${API_ENDPOINT}?customerId=${customerId}&limit=${ITEMS_PER_PAGE}&page=${page}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
        });
  
        if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);
  
        const result = await response.json();
        if (result.code !== 0) throw new Error(result.message || 'API returned an error');
  
        // **【核心对接区】**
        // 从 result.data.orders 获取订单列表
        const orders = result.data.orders || []; 
        // 从 result.totalCount 获取总数
        const totalCount = result.totalCount || 0;
  
        renderOrders(orders);
        renderPagination(totalCount, page);
  
      } catch (error) {
        console.error('Failed to fetch orders:', error);
        listContainer.style.display = 'none';
        emptyStateContainer.style.display = 'block';
      } finally {
        loader.style.display = 'none';
      }
    };
  
    // --- 事件监听 (Event Listeners) ---
    
    paginationContainer.addEventListener('click', (event) => {
      const button = event.target.closest('.pagination-button');
      if (button && !button.disabled) {
        const page = parseInt(button.dataset.page, 10);
        fetchOrders(page);
      }
    });
  
    // 初始加载
    fetchOrders(1);
  });
  </script>

{% schema %}
{
  "name": "Order Report List",
  "tag": "section"
}
{% endschema %}