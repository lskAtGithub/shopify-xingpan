          </g>
          <defs>
          <clipPath id="clip0_2450_205">
          <rect width="64" height="64" fill="white"/>
          </clipPath>
          </defs>
        </svg>
        <p class="empty-state-text">You don’t have an energy report yet, go test it</p>
        <a href="https://www.11starsastro.com/" class="button empty-state-button">Go test</a>
      </div>
    </div>
  </div>
{% endunless %}

<style>
  /* --- Previous styles remain the same --- */
  .order-report-page { max-width: 1200px; min-height: 430px; margin: 0 auto; padding: 20px; }
  .order-report-notification { display: flex; align-items: center; justify-content: center; background-color: #f0f5ff; border: 1px solid #d6e4ff; color: #595959; padding: 12px; border-radius: 8px; margin-bottom: 24px; font-size: 14px; }
  .order-report-notification svg { margin-right: 8px; }
  .order-table { width: 100%; border-collapse: collapse; border: 1px solid #e8e8e8; border-radius: 8px; overflow: hidden; }
  .order-table th, .order-table td { padding: 16px; text-align: left; }
  .order-table thead { background-color: #fafafa; }
  .order-table th { color: #595959; font-weight: 500; }
  .order-table tbody tr { border-top: 1px solid #e8e8e8; }
  .order-table tbody tr:hover { background-color: #f9f9f9; }
  .status-badge { padding: 4px 10px; border-radius: 12px; font-size: 12px; font-weight: 500; text-align: center; }
  .status--fulfilled { background-color: #e6f7ff; color: #1890ff; }
  .status--unfulfilled { background-color: #fffbe6; color: #faad14; }
  .status--canceled { background-color: #fff1f0; color: #f5222d; }
  .action-button { padding: 8px 16px; border-radius: 6px; border: 1px solid transparent; cursor: pointer; font-weight: 500; transition: all 0.3s; }
  .action-button.primary { background-color: #2c2c2c; color: #fff; }
  .action-button.primary:hover { opacity: 0.8; }
  .action-button.disabled { background-color: #d9d9d9; color: #8c8c8c; cursor: not-allowed; }
  .order-card-list { display: none; flex-direction: column; gap: 16px; }
  .order-card { background-color: #fff; border: 1px solid #e8e8e8; border-radius: 8px; padding: 16px; display: grid; grid-template-areas: "number status" "customer price" "date date" "action action"; grid-template-columns: 1fr auto; gap: 8px 16px; }
  .order-card .order-number { grid-area: number; font-weight: 600; font-size: 16px; }
  .order-card .status-badge { grid-area: status; justify-self: end; }
  .order-card .customer-name { grid-area: customer; color: #595959; }
  .order-card .total-price { grid-area: price; font-weight: 600; font-size: 18px; justify-self: end; }
  .order-card .order-date { grid-area: date; color: #8c8c8c; font-size: 14px; }
  .order-card .action-button { grid-area: action; width: 100%; text-align: center; margin-top: 8px; }
  .empty-state-container { padding: 60px 20px; text-align: center; }
  .empty-state-content { max-width: 400px; margin: 0 auto; }
  .empty-state-icon { margin-bottom: 24px; width: 72px; height: 72px; }
  .empty-state-text { font-size: 18px; color: #595959; margin-bottom: 24px; }
  .empty-state-button { background-color: #2c2c2c; color: #fff; padding: 12px 24px; }
  .loading-spinner { display: flex; justify-content: center; padding: 50px; }
  .spinner { border: 4px solid #f3f3f3; border-top: 4px solid #3498db; border-radius: 50%; width: 40px; height: 40px; animation: spin 1s linear infinite; }
  @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }

  /* --- NEW & UPDATED PAGINATION STYLES --- */
  .pagination-wrapper { display: flex; justify-content: flex-end; align-items: center; margin-top: 32px; }
  .pagination-button { display: flex; align-items: center; justify-content: center; width: 36px; height: 36px; margin: 0 4px; border: 1px solid #d9d9d9; background-color: #fff; border-radius: 6px; cursor: pointer; transition: border-color 0.3s, color 0.3s; }
  .pagination-button:hover:not(:disabled) { border-color: #1890ff; color: #1890ff; }
  .pagination-button:disabled { cursor: not-allowed; opacity: 0.5; color: #ccc; }
  .pagination-button svg { width: 18px; height: 18px; stroke: currentColor; }

  @media (max-width: 768px) {
    .order-table { display: none; }
    .order-card-list { display: flex; }
    .pagination-wrapper { justify-content: center; } /* Center pagination on mobile */
  }
  @media (min-width: 769px) {
    .order-table { display: table; }
    .order-card-list { display: none; }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const pageContainer = document.querySelector('.order-report-page');
    if (!pageContainer) return;
  
    const customerId = pageContainer.dataset.customerId;
    const baseUrl = 'https://api.11starsastro.com';
    const API_ENDPOINT = baseUrl + '/order/getOrderList';
    const ITEMS_PER_PAGE = 1;
  
    // --- State Management for Pagination ---
    let currentPage = 1;
    let pageInfoHistory = ['']; // History of pageInfo tokens. First page is empty.
    let hasNextPage = false;
    let allOrders = []; // Cache all fetched orders to avoid re-fetching
  
    // --- DOM Element References ---
    const loader = document.querySelector('.loading-spinner');
    const listContainer = document.querySelector('.order-list-container');
    const tableBody = document.querySelector('.order-table-body');
    const cardList = document.querySelector('.order-card-list');
    const emptyStateContainer = document.querySelector('.empty-state-container');
    const paginationContainer = document.querySelector('.pagination-wrapper');
  
    // --- NEW Pagination UI Rendering ---
    const renderPagination = () => {
      paginationContainer.innerHTML = `
        <button class="pagination-button" id="prev-page" aria-label="Previous page">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
        </button>
        <button class="pagination-button" id="next-page" aria-label="Next page">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </button>
      `;
  
      const prevButton = document.getElementById('prev-page');
      const nextButton = document.getElementById('next-page');
  
      prevButton.disabled = currentPage <= 1;
      nextButton.disabled = !hasNextPage;
      
      // Show pagination only if there's more than one page (either past or future)
      paginationContainer.style.display = (currentPage > 1 || hasNextPage) ? 'flex' : 'none';
    };
  
    // --- REFACTORED API Fetch Function ---
    const fetchOrders = async (direction) => {
      loader.style.display = 'flex';
      listContainer.style.display = 'none';
      paginationContainer.style.display = 'none';
  
      let pageInfoToSend = '';
      
      if (direction === 'next') {
        pageInfoToSend = pageInfoHistory[currentPage] || '';
        currentPage++;
      } else if (direction === 'prev') {
        currentPage--;
        pageInfoToSend = pageInfoHistory[currentPage - 1] || '';
      } else { // Initial load
        currentPage = 1;
        pageInfoHistory = [''];
      }
  
      try {
        // Build the URL with pageInfo if it exists
        let url = `${API_ENDPOINT}?customerId=${customerId}&limit=${ITEMS_PER_PAGE}`;
        if(pageInfoToSend) {
          url += `&pageInfo=${encodeURIComponent(pageInfoToSend)}`;
        }
  
        const response = await fetch(url, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
        });
  
        if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);
        const result = await response.json();
        if (result.code !== 0) throw new Error(result.message || 'API returned an error');
  
        const orders = result.data.orders || [];
        const nextPageInfo = result.data.pageInfo;
  
        hasNextPage = !!nextPageInfo; // If pageInfo exists, there is a next page
        
        if (hasNextPage) {
          // Store the token for the *next* page at the *current* page's index
          pageInfoHistory[currentPage] = nextPageInfo;
        }
        
        if(orders.length === 0 && currentPage === 1) {
          emptyStateContainer.style.display = 'block';
        } else {
          emptyStateContainer.style.display = 'none';
          listContainer.style.display = 'block';
          renderOrders(orders); // Re-render with the new page's data
          renderPagination();
        }
  
      } catch (error) {
        console.error('Failed to fetch orders:', error);
        listContainer.style.display = 'none';
        emptyStateContainer.style.display = 'block';
      } finally {
        loader.style.display = 'none';
      }
    };
  
    // --- NEW Event Listeners ---
    paginationContainer.addEventListener('click', (event) => {
      const button = event.target.closest('.pagination-button');
      if (!button || button.disabled) return;
  
      if (button.id === 'next-page') {
        fetchOrders('next');
      } else if (button.id === 'prev-page') {
        // For prev, we don't need to re-fetch if we cache data.
        // But for cursor pagination, we MUST re-fetch with the previous page's cursor.
        fetchOrders('prev');
      }
    });
  
    // --- Initial Load ---
    fetchOrders('initial');
  
  
    // --- Helper function copies (to make the script standalone) ---
    const getOrderStatus = (order) => {
      if (order.cancelled_at) return 'Canceled';
      return order.fulfillment_status ? 'Fulfilled' : 'UnFulfilled';
    };
    const getStatusBadge = (statusText) => {
      const statusClass = `status--${statusText.toLowerCase()}`;
      return `<span class="status-badge ${statusClass}">${statusText}</span>`;
    };
    const getActionButton = (order) => {
      const status = getOrderStatus(order);
      if (order.report_url) {
          return `<a href="${order.report_url}" class="action-button primary">View Report</a>`;
      }
      if (status === 'Fulfilled') {
          return `<button class="action-button primary" data-order-id="${order.id}">Get the in-depth report</button>`;
      }
      return `<button class="action-button disabled" disabled>Get the in-depth report</button>`;
    };
    const renderOrders = (orders) => {
      tableBody.innerHTML = '';
      cardList.innerHTML = '';
      orders.forEach(order => {
          const statusText = getOrderStatus(order);
          const orderData = {
              number: order.name,
              date: order.created_at ? new Date(order.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : 'N/A',
              customer: (order.customer && `${order.customer.first_name || ''} ${order.customer.last_name || ''}`.trim()) || 'Liam Johnson',
              total: `$${parseFloat(order.current_total_price).toFixed(2)}`,
              status: statusText
          };
          const tableRow = `<tr><td>${orderData.number}</td><td>${orderData.date}</td><td>${orderData.customer}</td><td>${orderData.total}</td><td>${getStatusBadge(orderData.status)}</td><td>${getActionButton(order)}</td></tr>`;
          tableBody.insertAdjacentHTML('beforeend', tableRow);
          const mobileCard = `<div class="order-card"><span class="order-number">${orderData.number}</span>${getStatusBadge(orderData.status)}<span class="customer-name">${orderData.customer}</span><span class="total-price">${orderData.total}</span><span class="order-date">${orderData.date}</span>${getActionButton(order)}</div>`;
          cardList.insertAdjacentHTML('beforeend', mobileCard);
      });
    };
  });
  </script>

{% schema %}
{
  "name": "Order Report List",
  "tag": "section"
}
{% endschema %}
