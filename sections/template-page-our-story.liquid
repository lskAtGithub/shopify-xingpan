{% comment %}
  Our Story Page Template Section (Optimized Part 1)
  - Part 1 (Philosophy) is redesigned to match the new UI.
  - Part 2 (Expert) remains unchanged.
{% endcomment %}

<div class="our-story-page section-{{ section.id }}">
  <!-- Part 1: Business Philosophy (REDESIGNED) -->
  <div class="story-part philosophy-section">
    <div class="page-width">
      <div class="story-grid">
        <div class="story-grid__media">
          {% if section.settings.philosophy_image != blank %}
            {{ section.settings.philosophy_image | image_url: width: 1200 | image_tag: class: 'philosophy-image', loading: 'lazy', widths: '400, 600, 800, 1000, 1200', sizes: '(max-width: 768px) 100vw, 50vw' }}
          {% else %}
            <div class="placeholder-wrapper">
              {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          {% endif %}
        </div>
        <div class="story-grid__content philosophy-slider">
          <h2 class="h1-style">{{ section.settings.philosophy_title }}</h2>
          <div class="philosophy-slides-wrapper" id="philosophy-slides">
            {% for block in section.blocks %}
              <div class="philosophy-slide {% if forloop.first %}is-active{% endif %}" data-slide-id="{{ forloop.index }}" {{ block.shopify_attributes }}>
                <div class="quote-container">
                  <div class="quote-decorator">
                    <span class="line"></span>
                    <svg class="quote-icon" xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="currentColor"><path d="M9.983 3v7.391c0 2.908-2.355 5.264-5.263 5.264s-5.264-2.356-5.264-5.264V3h10.527zm14.017 0v7.391c0 2.908-2.355 5.264-5.263 5.264s-5.264-2.356-5.264-5.264V3h10.527z"/></svg>
                    <span class="line"></span>
                  </div>
                  <p class="quote-text">{{ block.settings.quote | escape }}</p>
                  <div class="quote-decorator">
                    <span class="line line--full"></span>
                  </div>
                </div>
              </div>
            {% endfor %}
          </div>
          <div class="philosophy-pagination" id="philosophy-pagination">
            {% for block in section.blocks %}
              <button type="button" class="pagination-dot {% if forloop.first %}is-active{% endif %}" data-target-id="{{ forloop.index }}">
                {{ forloop.index | prepend: '0' }}
              </button>
            {% endfor %}
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Part 2: Meet Our Expert (UNCHANGED) -->
  <div class="story-part expert-section">
    <div class="page-width">
      <div class="story-grid story-grid--reversed">
        <div class="story-grid__media">
          {% if section.settings.expert_image != blank %}
            {{ section.settings.expert_image | image_url: width: 1200 | image_tag: class: 'expert-image', loading: 'lazy', widths: '400, 600, 800, 1000, 1200', sizes: '(max-width: 768px) 100vw, 50vw' }}
          {% else %}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
          {% endif %}
        </div>
        <div class="story-grid__content">
          <h2 class="h1-style">{{ section.settings.expert_title }}</h2>
          <p class="expert-quote">“{{ section.settings.expert_quote | escape }}”</p>
          <span class="expert-name">— {{ section.settings.expert_name | escape }}</span>
        </div>
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .our-story-page {
    --text-color: #555;
    --heading-color: #111;
    --accent-color: #333;
    color: var(--text-color);
  }
  .story-part {
    padding: 4rem 0;
  }
  @media (min-width: 769px) {
    .story-part {
      padding: 6rem 0;
    }
  }
  .page-width {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  .h1-style {
    font-size: 3.5rem; /* Larger font size */
    font-weight: 400; /* Lighter font weight */
    color: var(--heading-color);
    margin-bottom: 3rem;
    line-height: 1.2;
    font-family: serif; /* More elegant font */
  }

  .story-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  .story-grid__media img {
    width: 100%;
    height: auto;
  }
  .story-grid__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  
  /* --- Part 1: Philosophy Section Styles (OPTIMIZED) --- */
  .philosophy-section {
    background-color: #f8f9fa; /* Light gray background */
  }
  .philosophy-image {
    box-shadow: 0 15px 30px -10px rgba(0,0,0,0.1); /* Subtle shadow */
  }
  .philosophy-slider {
    position: relative;
    text-align: center;
  }
  .philosophy-slides-wrapper {
    position: relative;
    min-height: 150px;
  }
  .philosophy-slide {
    opacity: 0; visibility: hidden; position: absolute;
    top: 0; left: 0; width: 100%;
    transition: opacity 0.5s ease, visibility 0.5s ease;
  }
  .philosophy-slide.is-active {
    opacity: 1; visibility: visible; position: static;
  }
  
  .quote-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }
  .quote-decorator {
    display: flex;
    align-items: center;
    width: 80%;
    max-width: 300px;
  }
  .quote-decorator .line {
    flex-grow: 1;
    height: 1px;
    background-color: #ddd;
  }
  .quote-decorator .line--full {
     width: 100%;
  }
  .quote-icon {
    color: var(--heading-color);
    flex-shrink: 0;
    margin: 0 1rem;
    height: 24px;
    width: 24px;
  }
  .quote-text {
    font-size: 1.125rem;
    line-height: 1.8;
    max-width: 450px;
    margin: 0 auto;
  }

  .philosophy-pagination {
    margin-top: 3rem;
    display: flex;
    justify-content: center;
    gap: 1rem;
  }
  .pagination-dot {
    background: none;
    border: 1.5px solid transparent;
    color: #999;
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
  }
  .pagination-dot.is-active {
    border-color: var(--accent-color);
    color: var(--accent-color);
  }

  /* --- Part 2: Expert Section Styles (UNCHANGED) --- */
  .expert-image {
    border-radius: 12px;
  }
  .expert-quote {
    font-size: 1.25rem;
    line-height: 1.7;
    margin-bottom: 1.5rem;
  }
  .expert-name {
    font-style: italic;
    color: var(--text-color);
  }

  /* --- Responsive Layout --- */
  @media (max-width: 768px) {
    .h1-style { font-size: 2.5rem; }
  }

  @media (min-width: 769px) {
    .story-grid {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
      align-items: center;
    }
    .story-grid--reversed .story-grid__media {
      order: 2;
    }
  }
{% endstylesheet %}

<script>
  // JavaScript is unchanged and remains valid.
  document.addEventListener('DOMContentLoaded', () => {
    const paginationContainer = document.getElementById('philosophy-pagination');
    const slidesContainer = document.getElementById('philosophy-slides');
    if (!paginationContainer || !slidesContainer) return;
    const dots = paginationContainer.querySelectorAll('.pagination-dot');
    const slides = slidesContainer.querySelectorAll('.philosophy-slide');
    paginationContainer.addEventListener('click', (event) => {
      const targetDot = event.target.closest('.pagination-dot');
      if (!targetDot) return;
      const targetId = targetDot.dataset.targetId;
      dots.forEach(dot => dot.classList.remove('is-active'));
      targetDot.classList.add('is-active');
      slides.forEach(slide => {
        slide.classList.toggle('is-active', slide.dataset.slideId === targetId);
      });
    });
  });
</script>

{% schema %}
{
  "name": "Our Story Page",
  "settings": [
    {
      "type": "header",
      "content": "Part 1: Business Philosophy"
    },
    {
      "type": "image_picker",
      "id": "philosophy_image",
      "label": "Philosophy Image"
    },
    {
      "type": "text",
      "id": "philosophy_title",
      "label": "Title",
      "default": "Business Philosophy"
    },
    {
      "type": "header",
      "content": "Part 2: Meet Our Expert"
    },
    {
      "type": "image_picker",
      "id": "expert_image",
      "label": "Expert Image"
    },
    {
      "type": "text",
      "id": "expert_title",
      "label": "Title",
      "default": "Meet Our Trade Expert"
    },
    {
      "type": "textarea",
      "id": "expert_quote",
      "label": "Quote",
      "default": "I have a passion for art and am honored to be able to connect astrological signs with beautiful works of art. As a Trade Account Manager at 11starts, my goal is to create a memorable product experience for you and help you achieve a better mood and life."
    },
    {
      "type": "text",
      "id": "expert_name",
      "label": "Name",
      "default": "Megan Dagen"
    }
  ],
  "blocks": [
    {
      "type": "philosophy_item",
      "name": "Philosophy Item",
      "limit": 4,
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "It's important that the artwork feels curated and elevated, and the quality from 11stars met those expectations."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Our Story Page",
      "blocks": [
        { "type": "philosophy_item" },
        { "type": "philosophy_item" },
        { "type": "philosophy_item" },
        { "type": "philosophy_item" }
      ]
    }
  ]
}
{% endschema %}