{% comment %}
  Our Story Page Template Section
  - Implements a two-part layout with a slider/tabs for business philosophy.
  - Fully configurable via theme editor settings and blocks.
{% endcomment %}

<div class="our-story-page section-{{ section.id }}">
  <!-- Part 1: Business Philosophy -->
  <div class="story-part philosophy-section">
    <div class="page-width">
      <div class="story-grid">
        <div class="story-grid__media">
          {% if section.settings.philosophy_image != blank %}
            {{ section.settings.philosophy_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400, 600, 800, 1000, 1200', sizes: '(max-width: 768px) 100vw, 50vw' }}
          {% else %}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {% endif %}
        </div>
        <div class="story-grid__content philosophy-slider">
          <h2 class="h1-style">{{ section.settings.philosophy_title }}</h2>
          <div class="philosophy-slides-wrapper" id="philosophy-slides">
            {% for block in section.blocks %}
              <div class="philosophy-slide {% if forloop.first %}is-active{% endif %}" data-slide-id="{{ forloop.index }}" {{ block.shopify_attributes }}>
                <div class="quote-icon">
                  <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="currentColor"><path d="M9.983 3v7.391c0 2.908-2.355 5.264-5.263 5.264s-5.264-2.356-5.264-5.264V3h10.527zm14.017 0v7.391c0 2.908-2.355 5.264-5.263 5.264s-5.264-2.356-5.264-5.264V3h10.527z"/></svg>
                </div>
                <p class="quote-text">{{ block.settings.quote | escape }}</p>
              </div>
            {% endfor %}
          </div>
          <div class="philosophy-pagination" id="philosophy-pagination">
            {% for block in section.blocks %}
              <button type="button" class="pagination-dot {% if forloop.first %}is-active{% endif %}" data-target-id="{{ forloop.index }}">
                {{ forloop.index | prepend: '0' }}
              </button>
            {% endfor %}
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Part 2: Meet Our Expert -->
  <div class="story-part expert-section">
    <div class="page-width">
      <div class="story-grid story-grid--reversed">
        <div class="story-grid__media">
          {% if section.settings.expert_image != blank %}
            {{ section.settings.expert_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400, 600, 800, 1000, 1200', sizes: '(max-width: 768px) 100vw, 50vw' }}
          {% else %}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
          {% endif %}
        </div>
        <div class="story-grid__content">
          <h2 class="h1-style">{{ section.settings.expert_title }}</h2>
          <p class="expert-quote">“{{ section.settings.expert_quote | escape }}”</p>
          <span class="expert-name">— {{ section.settings.expert_name | escape }}</span>
        </div>
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
.our-story-page {
  --text-color: #333;
  --heading-color: #111;
  --accent-color: #555;
  color: var(--text-color);
}
.story-part {
  padding: 4rem 0;
}
@media (min-width: 769px) {
  .story-part {
    padding: 6rem 0;
  }
}
.page-width {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 1.5rem;
}
.h1-style {
  font-size: 2.5rem;
  font-weight: 400;
  color: var(--heading-color);
  margin-bottom: 2rem;
  line-height: 1.2;
}

.story-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 2rem;
}
.story-grid__media img {
  width: 100%;
  height: auto;
  border-radius: 12px;
}
.story-grid__content {
  display: flex;
  flex-direction: column;
  justify-content: center;
}

/* Philosophy Section Specifics */
.philosophy-slider {
  position: relative;
}
.philosophy-slides-wrapper {
  position: relative;
  min-height: 150px; /* Prevent layout shift */
}
.philosophy-slide {
  opacity: 0;
  visibility: hidden;
  position: absolute;
  top: 0;
  left: 0;
  transition: opacity 0.5s ease, visibility 0.5s ease;
}
.philosophy-slide.is-active {
  opacity: 1;
  visibility: visible;
  position: static;
}
.quote-icon {
  color: var(--accent-color);
  opacity: 0.2;
  margin-bottom: 1rem;
}
.quote-text {
  font-size: 1.125rem;
  line-height: 1.8;
  padding: 1rem 0;
  border-top: 1px solid #e0e0e0;
  border-bottom: 1px solid #e0e0e0;
}
.philosophy-pagination {
  margin-top: 2rem;
  display: flex;
  gap: 1.5rem;
}
.pagination-dot {
  background: none;
  border: none;
  font-size: 0.875rem;
  cursor: pointer;
  padding: 0.5rem;
  color: #aaa;
  position: relative;
}
.pagination-dot::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 0;
  height: 2px;
  background-color: var(--accent-color);
  transition: width 0.3s ease;
}
.pagination-dot.is-active {
  color: var(--accent-color);
  font-weight: 600;
}
.pagination-dot.is-active::after {
  width: 100%;
}

/* Expert Section Specifics */
.expert-quote {
  font-size: 1.25rem;
  line-height: 1.7;
  margin-bottom: 1.5rem;
}
.expert-name {
  font-style: italic;
  color: var(--accent-color);
}

/* Responsive Layout */
@media (min-width: 769px) {
  .story-grid {
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }
  .story-grid--reversed .story-grid__media {
    order: 2;
  }
}
{% endstylesheet %}

<script>
document.addEventListener('DOMContentLoaded', () => {
  const paginationContainer = document.getElementById('philosophy-pagination');
  const slidesContainer = document.getElementById('philosophy-slides');

  if (!paginationContainer || !slidesContainer) return;

  const dots = paginationContainer.querySelectorAll('.pagination-dot');
  const slides = slidesContainer.querySelectorAll('.philosophy-slide');

  paginationContainer.addEventListener('click', (event) => {
    const targetDot = event.target.closest('.pagination-dot');
    if (!targetDot) return;

    const targetId = targetDot.dataset.targetId;

    // Update dots
    dots.forEach(dot => dot.classList.remove('is-active'));
    targetDot.classList.add('is-active');

    // Update slides
    slides.forEach(slide => {
      if (slide.dataset.slideId === targetId) {
        slide.classList.add('is-active');
      } else {
        slide.classList.remove('is-active');
      }
    });
  });
});
</script>

{% schema %}
{
  "name": "Our Story Page",
  "settings": [
    {
      "type": "header",
      "content": "Part 1: Business Philosophy"
    },
    {
      "type": "image_picker",
      "id": "philosophy_image",
      "label": "Philosophy Image"
    },
    {
      "type": "text",
      "id": "philosophy_title",
      "label": "Title",
      "default": "Business Philosophy"
    },
    {
      "type": "header",
      "content": "Part 2: Meet Our Expert"
    },
    {
      "type": "image_picker",
      "id": "expert_image",
      "label": "Expert Image"
    },
    {
      "type": "text",
      "id": "expert_title",
      "label": "Title",
      "default": "Meet Our Trade Expert"
    },
    {
      "type": "textarea",
      "id": "expert_quote",
      "label": "Quote",
      "default": "I have a passion for art and am honored to be able to connect astrological signs with beautiful works of art. As a Trade Account Manager at 11starts, my goal is to create a memorable product experience for you and help you achieve a better mood and life."
    },
    {
      "type": "text",
      "id": "expert_name",
      "label": "Name",
      "default": "Megan Dagen"
    }
  ],
  "blocks": [
    {
      "type": "philosophy_item",
      "name": "Philosophy Item",
      "limit": 4,
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "It's important that the artwork feels curated and elevated, and the quality from 11stars met those expectations."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Our Story Page",
      "blocks": [
        { "type": "philosophy_item" },
        { "type": "philosophy_item" },
        { "type": "philosophy_item" },
        { "type": "philosophy_item" }
      ]
    }
  ]
}
{% endschema %}