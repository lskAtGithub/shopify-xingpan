  {% endstylesheet %}

  <script>
    window.customer = {% if customer %}
      {
        "id": {{ customer.id | json }} || '',
        "email": {{ customer.email | json }},
        "first_name": {{ customer.first_name | json }},
        "last_name": {{ customer.last_name | json }},
        "phone": {{ customer.phone | json }},
        "tags": {{ customer.tags | json }},
        "orders_count": {{ customer.orders_count | json }},
        "total_spent": {{ customer.total_spent | json }},
        "accepts_marketing": {{ customer.accepts_marketing | json }},
        "addresses": {{ customer.addresses | json }},
        "default_address": {{ customer.default_address | json }}
      }
      {% else %}
        null
      {% endif %};
    let lat = '';
    let lon = '';
    let reportId = '';
    const BASE_URL = 'https://api.11starsastro.com';
    document.addEventListener('DOMContentLoaded', function () {
      const countrySelect = document.getElementById('country');
      const stateSelect = document.getElementById('state');
      const spinner = document.getElementById('loading-spinner');
      const citySelect = document.getElementById('city');

       // --- 1. 初始化 Choices.js 实例 ---
      const commonConfig = {
        searchEnabled: true,
        searchPlaceholderValue: 'Search...',
        removeItemButton: false,
        itemSelectText: '',
        shouldSort: false // 保持API返回的顺序
    };

    const countryEl = document.getElementById('country');
    const stateEl = document.getElementById('state');
    const cityEl = document.getElementById('city');

    const countryChoices = new Choices(countryEl, { ...commonConfig, placeholder: true, placeholderValue: 'Select a country' });
    const stateChoices = new Choices(stateEl, { ...commonConfig, placeholder: true, placeholderValue: 'Select a state' });
    const cityChoices = new Choices(cityEl, { ...commonConfig, placeholder: true, placeholderValue: 'Select a city' });

      const API_URL = BASE_URL + '/city/getInfo';

      const loginPromptModal = document.getElementById('login-prompt-modal');
      if (!loginPromptModal) return;

      const overlay = loginPromptModal.querySelector('.modal-overlay');
      const loginPromptModalCloseBtn = loginPromptModal.querySelector('.modal-close-btn');

      // --- Function to open the modal ---
      window.openLoginPromptModal = function() {
        loginPromptModal.style.display = 'flex';
        document.body.style.overflow = 'hidden';
        setTimeout(() => {
          loginPromptModal.classList.add('is-open');
          loginPromptModal.setAttribute('aria-hidden', 'false');
        }, 10); // Small delay to allow CSS transition
      };

      // --- Function to close the modal ---
      window.closeLoginPromptModal = function() {
        loginPromptModal.classList.remove('is-open');
        loginPromptModal.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
        setTimeout(() => {
          loginPromptModal.style.display = 'none';
        }, 300); // Wait for transition to finish
      };

      // Event listeners for closing
      loginPromptModalCloseBtn.addEventListener('click', window.closeLoginPromptModal);
      overlay.addEventListener('click', window.closeLoginPromptModal);
      
      // Close on 'Escape' key press
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && loginPromptModal.classList.contains('is-open')) {
          window.closeLoginPromptModal();
        }
      });

      const PLACEHOLDERS = {
        country: 'Select Country',
        state: 'Select State/Province',
        city: 'Select City',
      };

      function createOption(text, value = '') {
        const opt = document.createElement('option');
        opt.value = value;
        opt.textContent = text;
        return opt;
      }

      function resetSelect(select, placeholder) {
        select.innerHTML = '';
        select.appendChild(createOption(placeholder, ''));
        select.disabled = true;
      }

      function setLoading(select) {
        select.innerHTML = '';
        select.appendChild(createOption('Loading...', ''));
        select.disabled = true;
      }

      function populateSelectWithObjects(select, items, textKey = 'name', valueKey = 'id') {
        select.innerHTML = '';
        select.appendChild(
          createOption(
            select === countrySelect
              ? PLACEHOLDERS.country
              : select === stateSelect
              ? PLACEHOLDERS.state
              : PLACEHOLDERS.city,
            ''
          )
        );
        if (!items || !items.length) {
          select.disabled = true;
          return;
        }
        items.forEach((item) => {
          const text = (item && (item[textKey] || item.name || String(item))) || '';
          const value =
            (item && (item[valueKey] !== undefined ? item[valueKey] : item.id !== undefined ? item.id : item)) || '';
          const opt = createOption(text, value);
          select.appendChild(opt);
          opt.dataset.latitude = item.latitude;
          opt.dataset.longitude = item.longitude;
        });
        select.disabled = false;
      }

      {% comment %} async function fetchFromApi(params = {}) {
        // 构造带查询串的 URL
        const url = new URL(API_URL);
        Object.keys(params).forEach((k) => {
          if (params[k] !== undefined && params[k] !== null && params[k] !== '') url.searchParams.append(k, params[k]);
        });

        try {
          const res = await fetch(url.toString(), { method: 'GET', mode: 'cors' });
          if (!res.ok) {
            throw new Error('HTTP ' + res.status);
          }
          const json = await res.json();
          // 兼容：返回包裹 { code, message, data: [...] } 的情形
          if (json && Array.isArray(json.data)) {
            return json.data;
          }
          // 有些接口可能直接返回数组
          if (Array.isArray(json)) {
            return json;
          }
          // 兜底返回空数组
          return [];
        } catch (err) {
          return [];
        }
      } {% endcomment %}

      // 初始化日期时间选择器的范围和语言
      const birthDateTimeInput = document.getElementById('birth-datetime');
      if (birthDateTimeInput) {
        // 设置最大值为当前时间
        const now = new Date();
        const year = now.getFullYear();
        const month = String(now.getMonth() + 1).padStart(2, '0');
        const day = String(now.getDate()).padStart(2, '0');
        const hours = String(now.getHours()).padStart(2, '0');
        const minutes = String(now.getMinutes()).padStart(2, '0');
        const maxDateTime = `${year}-${month}-${day}T${hours}:${minutes}`;
        birthDateTimeInput.max = maxDateTime;
        
        // 设置最小值为1900年1月1日
        birthDateTimeInput.min = '1900-01-01T00:00';
        
        // 尝试设置语言环境为英文
        try {
          // 对于支持该属性的浏览器
          birthDateTimeInput.setAttribute('lang', 'en');
          birthDateTimeInput.setAttribute('data-locale', 'en-US');
          
          // 尝试通过Intl API设置日期格式
          const options = { 
            year: 'numeric', 
            month: '2-digit', 
            day: '2-digit',
            hour: '2-digit',
            minute: '2-digit',
            hour12: false
          };
          const formatter = new Intl.DateTimeFormat('en-US', options);
          
          // 添加事件监听器，确保选择器使用英文
          birthDateTimeInput.addEventListener('focus', function() {
            this.setAttribute('lang', 'en');
          });
          
          birthDateTimeInput.addEventListener('click', function() {
            this.setAttribute('lang', 'en');
          });
          
          // 添加额外的点击事件监听器，强制触发日期选择器
          birthDateTimeInput.addEventListener('click', function() {
            // 确保元素已聚焦
            this.focus();
            
            // 使用现代浏览器支持的showPicker方法
            if (typeof this.showPicker === 'function') {
              try {
                this.showPicker();
              } catch (e) {
                // 忽略可能的错误，如在某些设备上showPicker可能不被支持
                console.log('showPicker method failed:', e);
              }
            }
          });
          
          // 添加触摸事件支持，针对移动设备
          birthDateTimeInput.addEventListener('touchstart', function(e) {
            e.preventDefault(); // 防止滚动
            this.focus();
            
            if (typeof this.showPicker === 'function') {
              try {
                this.showPicker();
              } catch (e) {
                console.log('Touch showPicker failed:', e);
              }
            }
          }, { passive: false });
        } catch (e) {
          console.log('Could not set locale for datetime input:', e);
        }
      }
      
      // 初始化：清空下级
      {% comment %} resetSelect(stateSelect, PLACEHOLDERS.state);
      resetSelect(citySelect, PLACEHOLDERS.city); {% endcomment %}

       // --- API 调用函数 ---
    const fetchFromApi = async (params = {}) => {
      const query = new URLSearchParams(params).toString();
      const url = `${API_URL}${query ? '?' + query : ''}`;
      try {
          const response = await fetch(url);
          if (!response.ok) throw new Error(`API Error: ${response.statusText}`);
          const result = await response.json();
          if (result.code !== 0) throw new Error(result.message || 'API returned an error');
          return result.data;
      } catch (error) {
          console.error('Failed to fetch location data:', error);
          // 在这里可以添加UI错误提示
          return []; // 返回空数组以避免后续代码出错
      }
  };
  
  // --- 联动逻辑 ---

  const loadCountries = async () => {
      countryChoices.clearStore();
      stateChoices.disable();
      cityChoices.disable();
      countryChoices.setChoices([{ value: '', label: 'Select countries', disabled: true, selected: true }], 'value', 'label', true);
      
      const countries = await fetchFromApi();
      
      // 关键: 格式化数据以包含自定义属性
      const choicesData = countries.map(item => ({
          value: item.id,
          label: item.name,
          customProperties: {
              latitude: item.latitude,
              longitude: item.longitude
          }
      }));
      
      countryChoices.setChoices(choicesData, 'value', 'label', true);
  };

  countryEl.addEventListener('change', async (event) => {
      const countryId = event.detail.value;
      const choice = event.detail.choice;

      // 清空并禁用下级
      stateChoices.clearStore();
      cityChoices.clearStore();
      cityChoices.disable();
      
      // 更新经纬度
      if (choice && choice.customProperties) {
          lat = choice.customProperties.latitude;
          lon = choice.customProperties.longitude;
      } else {
          lat = null;
          lon = null;
      }

      if (!countryId) {
        stateChoices.disable();
        return;
      }
      
      stateChoices.enable();
      stateChoices.setChoices([{ value: '', label: 'Select states', disabled: true, selected: true }], 'value', 'label', true);
      
      const states = await fetchFromApi({ countryId: countryId });
      
      const choicesData = states.map(item => ({
          value: item.id,
          label: item.name,
          customProperties: {
              latitude: item.latitude,
              longitude: item.longitude
          }
      }));
      
      stateChoices.setChoices(choicesData, 'value', 'label', true);
  });
  let cityData = [];
  stateEl.addEventListener('change', async (event) => {
      const stateId = event.detail.value;
      const choice = event.detail.choice;

      cityChoices.clearStore();
      
      if (choice && choice.customProperties) {
          lat = choice.customProperties.latitude;
          lon = choice.customProperties.longitude;
      }

      if (!stateId) {
          cityChoices.disable();
          return;
      }

      cityChoices.enable();
      cityChoices.setChoices([{ value: '', label: 'Select cities', disabled: true, selected: true }], 'value', 'label', true);
      
      const cities = await fetchFromApi({ stateId: stateId });
      
      const choicesData = cities.map(item => ({
          value: item.id,
          label: item.name,
          customProperties: {
              latitude: item.latitude,
              longitude: item.longitude
          }
      }));
      cityData = choicesData;
      cityChoices.setChoices(choicesData, 'value', 'label', true);
  });

  cityEl.addEventListener('change', (event) => {
      const choice = event.detail.choice;
      const val = event.detail.value;
      if(val) {
        cityData.forEach(item => {
            if(item.value == val) {
                lat = item.customProperties.latitude;
                lon = item.customProperties.longitude;
            }
        });
      }
      if (choice && choice.customProperties) {
          lat = choice.customProperties.latitude;
          lon = choice.customProperties.longitude;
      }
  });

  // 初始加载
  loadCountries();

      // 加载国家列表（页面加载时）
