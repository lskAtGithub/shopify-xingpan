{% comment %} {{ 'get_report.css' | asset_url | stylesheet_tag }} {% endcomment %}
<!-- 引入Chart.js和自定义脚本 -->
{% comment %} <script src="https://cdn.jsdelivr.net/npm/chart.js@2.9.4/dist/Chart.min.js"></script> {% endcomment %}
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.7.1/chart.js"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/choices.js/public/assets/styles/choices.min.css">
<script src="https://cdn.jsdelivr.net/npm/choices.js/public/assets/scripts/choices.min.js"></script>
<section class="get-report-section section-{{ section.id }}">
  <div class="report-container">
    <div class="bg-gradient-to-br">
      <div class="flex-wrap">
        <!-- 左侧内容 -->
        <div class="left-content">
          {% if section.settings.heading != blank %}
            <h2 class="heading">{{ section.settings.heading }}</h2>
          {% endif %}

          {% if section.settings.subheading != blank %}
            <p class="subheading">{{ section.settings.subheading }}</p>
          {% endif %}

          <div class="note-line">
            {% comment %} <i class="fa fa-star"></i> {% endcomment %}
            <svg
              class="icon-star"
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 16 16"
              fill="none"
            >
              <g clip-path="url(#clip0_619_771)">
              <path d="M12.1519 15.6565C11.9601 15.6565 11.7682 15.6086 11.5604 15.4967L8.33158 13.8024C8.25166 13.7544 8.13977 13.7224 8.01191 13.7224C7.90002 13.7224 7.77214 13.7544 7.69222 13.7864L4.47936 15.4967C4.28755 15.6086 4.09573 15.6565 3.87195 15.6565C3.48833 15.6565 3.12069 15.4807 2.86492 15.193C2.60917 14.9053 2.51328 14.5217 2.5772 14.138L3.20061 10.5575C3.23258 10.3337 3.15265 10.11 2.99279 9.95012L0.403339 7.44055C0.0356981 7.08891 -0.092177 6.5774 0.0676669 6.09786C0.227495 5.61832 0.62712 5.28265 1.12264 5.20272L4.70314 4.67524C4.92692 4.64327 5.1347 4.49941 5.23061 4.3076L6.82905 1.04678C7.05283 0.599219 7.50039 0.327484 7.99591 0.327484C8.49142 0.327484 8.93899 0.599219 9.16277 1.04678L10.7612 4.3076C10.8731 4.51541 11.0649 4.64327 11.2887 4.67524L14.8692 5.20274C15.3647 5.28266 15.7643 5.61833 15.9242 6.08188C16.084 6.56141 15.9562 7.07291 15.6045 7.42458L13.031 9.9501C12.8552 10.1099 12.7912 10.3337 12.8232 10.5575L13.4306 14.122C13.4945 14.5057 13.3986 14.8893 13.1429 15.177C12.9031 15.4807 12.5355 15.6565 12.1519 15.6565Z" fill="#FFD324"/>
              </g>
              <defs>
              <clipPath id="clip0_619_771">
              <rect width="16" height="16" fill="white"/>
              </clipPath>
              </defs>
            </svg>
            <p>{{ section.settings.note_text }}</p>
          </div>

          {% if section.settings.top_image != blank %}
            <div class="top-img-container">
              {{
                section.settings.top_image
                | image_url: width: 800
                | image_tag:
                  class: 'top-img',
                  loading: 'lazy',
                  widths: '400, 600, 800',
                  sizes: '(max-width: 768px) 100vw, 50vw'
              }}
            </div>
          {% endif %}
        </div>

        <!-- 右侧表单 -->
        <div class="form-container">
          <form id="report-form">
            <div class="form-group">
              <label for="name">Full Name <span class="required">*</span></label>
              <input class="ipt" type="text" id="name" name="name" placeholder="Enter your full name" required value="">
            </div>
            <!-- 日期时间选择器 -->
            <div class="form-group">
              <label for="birth-datetime">Birth Date & Time <span class="required">*</span></label>
              <input
                class="ipt datetime-local-en"
                type="datetime-local"
                lang="en"
                id="birth-datetime"
                name="birth_datetime"
                required
                value=""
                placeholder="Select date and time"
              >
              <p style="font-size: 12px; color: #666;">
                tips：If you don't know the exact time, choose the one you think is possible.
              </p>
            </div>

            <!-- 国家选择器 -->
            <div class="form-group">
              <label>Birth Location <span class="required">*</span></label>
              <div class="grid-cols-responsive">
                <div>
                  <label for="country">Country</label>
                  <select id="country" name="country" required>
                    <option value="">Select Country</option>
                  </select>
                </div>
                <div>
                  <label for="state">State/Province</label>
                  <select id="state" name="state" disabled required>
                    <option value="">Select State</option>
                  </select>
                </div>
                <div>
                  <label for="city">City</label>
                  <select id="city" name="city" disabled required>
                    <option value="">Select City</option>
                  </select>
                </div>
              </div>
            </div>
            {% comment %}
              <div class="form-group">
                <label>Birth Location <span class="required">*</span></label>
                <div class="grid-cols-responsive">
                  <div>
                    <label for="country">Country</label>
                    <select id="country" name="country" required>
                      <option value="">Select Country</option>
                    </select>
                  </div>
                  <div>
                    <label for="state">State/Province</label>
                    <select id="state" name="state" disabled required>
                      <option value="">Select State</option>
                    </select>
                  </div>
                  <div>
                    <label for="city">City</label>
                    <select id="city" name="city" disabled required>
                      <option value="">Select City</option>
                    </select>
                  </div>
                </div>
              </div>
            {% endcomment %}

            <div class="form-group">
              <label class="checkbox-label">
                <input class="ipt" type="checkbox" id="daylight-saving" name="daylight_saving">
                <span class="checkbox-check-text">Daylight Saving Time was in effect at birth</span>
              </label>
            </div>

            <button id="submit-btn" type="submit" class="gradient-btn">
              <span>{{ section.settings.button_text }}</span>
              <i class="fa fa-arrow-right"></i>
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>

  <!-- Loading Spinner -->
  <div class="report-spinner-container">
    <div class="report-spinner"></div>
    <p>Loading your reports...</p>
  </div>
  <!-- From Uiverse.io by dexter-st -->
