{% comment %}
  Filterable Blog Section (FIXED: Load all articles)
  - Disables pagination to load ALL articles from the blog for JS filtering.
  - The default limit for blog.articles without pagination is 50.
  - If you have more than 50 articles, a more advanced solution is needed.
{% endcomment %}
<style>
  .page-width.section-{{ section.id }} {
    max-width: 1280px;
    margin: 0 auto 2rem;
  }
</style>
<div class="page-width section-{{ section.id }}">
  <div class="blog-header">
    <h1>{{ blog.title }}</h1>
    {%- assign all_tags = blog.all_tags -%}
    {% if all_tags.size > 0 %}
      <nav class="filter-nav">
        <button class="filter-button active" data-filter="{{ 'All' | handle }}">All</button>
        {% comment %}
          To ensure the filter menu is always complete, we get tags from ALL articles,
          not just the paginated ones. The blog.all_tags object thankfully does this.
        {% endcomment %}
        {% for tag in all_tags %}
          {% if tag != 'All' %}
            <button class="filter-button" data-filter="{{ tag | handle }}">{{ tag }}</button>
          {% endif %}
        {% endfor %}
      </nav>
    {% endif %}
  </div>

  <div class="article-grid">
    {% for article in blog.articles %}
      <div class="article-card" data-tags="{{ article.tags | join: ' ' | handle }}">
        <a href="{{ article.url }}" class="article-card__image-wrapper">
          {% if article.image %}
            {{
              article.image
              | image_url: width: 800
              | image_tag:
                loading: 'lazy',
                widths: '400, 600, 800',
                sizes: '(max-width: 767px) 100vw, (max-width: 1023px) 33vw, 25vw'
            }}
          {% else %}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {% endif %}
          <div class="article-card__tags">
            {%- assign downcased_tag = article.tags | join: ' ' -%}
            <span
              class="tag"
              {% if downcased_tag == 'fire' %}
                style="background-color: #FFD100; color: #111;"
              {% elsif downcased_tag == 'water' %}
                style="background-color: #4A90E2;"
              {% elsif downcased_tag == 'earth' %}
                style="background-color: #8B5A2B;"
              {% elsif downcased_tag == 'air' %}
                style="background-color: #4CAF50;"
              {% endif %}
            >
              {{- article.tags -}}
            </span>
          </div>
        </a>
        <div class="article-card__info">
          <h2 class="article-card__title">
            <a href="{{ article.url }}">{{ article.title }}</a>
          </h2>
          <div class="article-card__excerpt">
            {{ article.excerpt_or_content | strip_html | truncate: 150 }}
          </div>
          <div class="article-card__meta">
            <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
              {{- article.published_at | date: '%B %d, %Y' -}}
            </time>
          </div>
        </div>
      </div>
    {% endfor %}

    {% if blog.articles.size == 0 %}
      {% for i in (1..4) %}
        <div class="article-card">
          <div class="article-card__image-wrapper">
            {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
          <div class="article-card__info">
            <h2 class="article-card__title">Example Blog Post Title</h2>
            <div class="article-card__excerpt">
              This is a placeholder for your blog post's excerpt. Start writing amazing content to engage your
              customers.
            </div>
          </div>
        </div>
      {% endfor %}
    {% endif %}
  </div>
</div>

{% stylesheet %}
  /* ... (CSS样式部分保持不变，无需修改) ... */
  .blog-header {
    text-align: center;
    margin-bottom: 50px;
  }
  .blog-header h1 {
    font-size: 2.8rem;
    margin-bottom: 30px;
  }
  .filter-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 15px;
  }
  .filter-button {
    background-color: transparent;
    border: 1px solid #ddd;
    padding: 10px 20px;
    border-radius: 9999px;
    cursor: pointer;
    font-size: 1rem;
    font-weight: 500;
    transition: all 0.2s ease;
  }
  .filter-button:hover {
    background-color: #f5f5f5;
    border-color: #ccc;
  }
  .filter-button.active {
    background-color: #2d3748;
    color: #fff;
    border-color: #2d3748;
  }
  .article-grid {
    display: grid;
    grid-template-columns: 1fr; /* Mobile: 1 column */
    gap: 30px;
    margin: 0 1.5rem;
  }
  .article-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: 12px;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    position: relative;
  }
  .article-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
  }
  .article-card .article-card__tags {
    display: flex;
    gap: 5px;
    margin-bottom: 10px;
    flex-wrap: wrap;
    justify-content: flex-start;
    align-items: center;
    position: absolute;
    top: 5px;
    left: 5px;
  }
  .article-card .article-card__tags .tag {
    background-color: #2d3748;
    color: #fff;
    padding: 5px 10px;
    border-radius: 9999px;
  }
  .article-card__image-wrapper {
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }
  .article-card__image-wrapper img,
  .article-card__image-wrapper .placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .article-card__info {
    padding: 20px;
  }
  .article-card__title {
    font-size: 1.2rem;
    margin: 0 0 10px 0;
  }
  .article-card__title a {
    text-decoration: none;
    color: inherit;
  }
  .article-card__excerpt {
    font-size: 0.95rem;
    color: #555;
    line-height: 1.6;
  }
  .article-card__meta {
    margin-top: 10px;
    font-size: 0.8rem;
    color: #999;
  }
  @media (min-width: 768px) {
    .article-grid {
      grid-template-columns: repeat(3, 1fr); /* Tablet: 3 columns */
    }
  }
  @media (min-width: 1024px) {
    .article-grid {
      grid-template-columns: repeat(4, 1fr); /* Desktop: 4 columns */
    }
  }
{% endstylesheet %}

<script>
  /* ... (JavaScript部分保持不变，无需修改) ... */
  document.addEventListener('DOMContentLoaded', () => {
    const filterButtons = document.querySelectorAll('.filter-button');
    const articleCards = document.querySelectorAll('.article-card');

    filterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        filterButtons.forEach((btn) => btn.classList.remove('active'));
        button.classList.add('active');
        const filter = button.getAttribute('data-filter');
        articleCards.forEach((card) => {
          const tags = card.getAttribute('data-tags');
          if (filter === 'all' || (tags && tags.includes(filter))) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  });
</script>

{% schema %}
{
  "name": "Filterable Blog",
  "settings": []
}
{% endschema %}
